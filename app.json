{
  "expo": {
    "name": "Animals Run",
    "slug": "animals-run",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.animalsrun.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 8,
      "package": "com.animalsrun.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FB7103"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-local-android-tools",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 205
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "커뮤니티에 올릴 사진을 고르기 위해 사진 접근을 사용해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지도에 내 위치와 주변 친구들을 보여주기 위해 위치를 사용해요."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "걸음 수를 세어 코인으로 바꿔주기 위해 동작 및 피트니스 정보를 사용해요."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
