    function isCatalogAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled == true;
    }
    match /gachaCatalog/{id} {
      allow read: if request.auth != null;
      allow create, update: if id == 'live' && isCatalogAdmin()
        && request.resource.data.schema == 1 && request.resource.data.collections is list
        && request.resource.data.get('editorVersion', 0) == 2
        && request.resource.data.collections.size() > 0 && request.resource.data.collections.size() <= 80
        && request.resource.data.version == (resource == null ? 1 : resource.data.version + 1)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    match /administrators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /gachaCatalogVersions/{id} {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled;
      allow create: if isCatalogAdmin() && request.resource.data.updatedAt == request.time
        && request.resource.data == getAfter(/databases/$(database)/documents/gachaCatalog/live).data;
      allow update, delete: if false;
    }
    match /gachaBanners/{id} {
      allow read: if request.auth != null;
      allow create, update: if isCatalogAdmin() && request.resource.data.version == getAfter(/databases/$(database)/documents/gachaCatalog/live).data.version;
    }
    match /gachaCharacters/{id} {
      allow read: if request.auth != null;
      allow create, update: if isCatalogAdmin();
    }
    match /gachaCollections/{id} {
      allow read: if request.auth != null;
      allow create, update: if isCatalogAdmin();
    }
    match /gachaImages/{id} {
      allow read: if request.auth != null;
      allow create: if isCatalogAdmin() && request.resource.data.keys().hasOnly(['data', 'createdAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 350000
        && request.resource.data.data.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
