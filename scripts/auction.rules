    // Player-to-player auction: list/buy inside the live band. 시세 becomes the average of
    // trades in each Korean-time 2-hour window. The band is quote * low/high, clamped per grade.
    // These helpers always go through get/getAfter so the same check works from users, listings and quotes.
    function auctionQuotes() { return __AUCTION_QUOTE__; }
    function auctionFloors() { return __AUCTION_FLOOR__; }
    function auctionCeils() { return __AUCTION_CEIL__; }
    function auctionListingPath(id) { return /databases/$(database)/documents/auctionListings/$(id); }
    function auctionBidPath(id) { return /databases/$(database)/documents/auctionBids/$(id); }
    function auctionQuotePath(id) { return /databases/$(database)/documents/auctionQuotes/$(id); }
    function auctionUserPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function auctionUserBefore(uid) { return get(auctionUserPath(uid)).data; }
    function auctionUserAfter(uid) { return getAfter(auctionUserPath(uid)).data; }
    function auctionBase(c) { return auctionQuotes().get(gradeOf(c), -1); }
    function auctionFloorOf(c) { return auctionFloors().get(gradeOf(c), -1); }
    function auctionCeilOf(c) { return auctionCeils().get(gradeOf(c), -1); }
    function auctionQuoteOf(c) {
      return exists(auctionQuotePath(c)) ? get(auctionQuotePath(c)).data.quote : auctionBase(c);
    }
    function auctionMinOf(c) {
      let lo = int(math.floor(auctionQuoteOf(c) * __AUCTION_LOW__ / 100.0));
      let floor = auctionFloorOf(c);
      return lo < floor ? floor : lo;
    }
    function auctionMaxOf(c) {
      let hi = int(math.ceil(auctionQuoteOf(c) * __AUCTION_HIGH__ / 100.0));
      let cap = auctionCeilOf(c);
      return hi > cap ? cap : hi;
    }
    function auctionSlot() {
      return int(math.floor((request.time.toMillis() + 32400000.0) / __AUCTION_WINDOW_MS__)) * __AUCTION_WINDOW_MS__ - 32400000;
    }
    function auctionClamp(c, n) {
      let floor = auctionFloorOf(c);
      let cap = auctionCeilOf(c);
      return n < floor ? floor : n > cap ? cap : n;
    }
    function auctionSettledQuote(c, before) {
      let count = before.get('windowCount', 0);
      return count == 0 ? before.quote : auctionClamp(c, int(math.round(before.windowSum / count)));
    }
    function auctionTrade(data) {
      return data.keys().hasOnly(['id', 'action', 'character', 'price'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.action in ['list', 'cancel', 'buy', 'sell', 'bid', 'cancelBid', 'fill', 'filled', 'editList', 'editBid']
        && data.character is string && gradeOf(data.character) in ['N', 'R', 'EP', 'U', 'L', 'E', 'H']
        && data.price is int && data.price > 0;
    }
    function auctionTraded(before, after) {
      return after.get('auctionTrades', 0) == before.get('auctionTrades', 0) + 1;
    }
    function auctionListingGone(id) { return !existsAfter(auctionListingPath(id)); }
    function validAuctionQuote(c, price) {
      let after = getAfter(auctionQuotePath(c)).data;
      let slot = auctionSlot();
      let keys = ['quote', 'trades', 'lastPrice', 'updatedAt', 'windowStart', 'windowSum', 'windowCount', 'lastWindowCount'];
      return after.keys().hasOnly(keys) && after.lastPrice == price && after.windowStart == slot
        && (exists(auctionQuotePath(c)) ? validAuctionQuoteUpdate(c, price, slot, after) : (
          after.quote == auctionBase(c) && after.trades == 1 && after.windowSum == price && after.windowCount == 1
          && after.lastWindowCount == 0 && after.updatedAt == request.time
        ));
    }
    function validAuctionQuoteUpdate(c, price, slot, after) {
      let before = get(auctionQuotePath(c)).data;
      let same = before.get('windowStart', 0) == slot;
      return after.quote == (same ? before.quote : auctionSettledQuote(c, before))
        && after.trades == before.trades + 1
        && after.windowSum == (same ? before.get('windowSum', 0) + price : price)
        && after.windowCount == (same ? before.get('windowCount', 0) + 1 : 1)
        && after.lastWindowCount == (same ? before.get('lastWindowCount', 0) : before.get('windowCount', 0))
        && (same ? after.updatedAt == before.updatedAt : after.updatedAt == request.time);
    }
    function isAuctionSettle(id) {
      let before = get(auctionQuotePath(id)).data;
      let after = request.resource.data;
      let slot = auctionSlot();
      return exists(auctionQuotePath(id)) && before.get('windowStart', 0) < slot
        && after.keys().hasOnly(['quote', 'trades', 'lastPrice', 'updatedAt', 'windowStart', 'windowSum', 'windowCount', 'lastWindowCount'])
        && after.quote == auctionSettledQuote(id, before) && after.trades == before.trades
        && after.lastPrice == before.lastPrice && after.windowStart == slot
        && after.windowSum == 0 && after.windowCount == 0
        && after.lastWindowCount == before.get('windowCount', 0) && after.updatedAt == request.time;
    }
    function isAuctionList(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let listing = getAfter(auctionListingPath(trade.id)).data;
      let remaining = before.characters.get(trade.character, 0) - 1;
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'list'
        && after.diff(before).affectedKeys().hasOnly(['characters', 'lastAuction'])
        && remaining >= (before.get('avatar', null) == trade.character ? 1 : 0)
        && after.characters.diff(before.characters).affectedKeys().hasOnly([trade.character])
        && after.characters.get(trade.character, 0) == remaining
        && !exists(auctionListingPath(trade.id))
        && listing.seller == uid && listing.character == trade.character && listing.price == trade.price
        && listing.price >= auctionMinOf(trade.character) && listing.price <= auctionMaxOf(trade.character);
    }
    function isAuctionCancel(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let listing = get(auctionListingPath(trade.id)).data;
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'cancel'
        && after.diff(before).affectedKeys().hasOnly(['characters', 'lastAuction'])
        && listing.seller == uid && listing.character == trade.character && listing.price == trade.price
        && auctionListingGone(trade.id)
        && after.characters.diff(before.characters).affectedKeys().hasOnly([trade.character])
        && after.characters.get(trade.character, 0) == before.characters.get(trade.character, 0) + 1;
    }
    function isAuctionBuy(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let listing = get(auctionListingPath(trade.id)).data;
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'buy'
        && after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'lastAuction', 'auctionTrades'])
        && auctionTraded(before, after)
        && listing.seller != uid && listing.character == trade.character && listing.price == trade.price
        && listing.price >= auctionMinOf(listing.character) && listing.price <= auctionMaxOf(listing.character)
        && before.coins >= listing.price && after.coins == before.coins - listing.price
        && auctionListingGone(trade.id) && validAuctionQuote(trade.character, listing.price)
        && after.characters.diff(before.characters).affectedKeys().hasOnly([trade.character])
        && after.characters.get(trade.character, 0) == before.characters.get(trade.character, 0) + 1;
    }
    function auctionBidGone(id) { return !existsAfter(auctionBidPath(id)); }
    function isAuctionBid(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let bid = getAfter(auctionBidPath(trade.id)).data;
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'bid'
        && after.diff(before).affectedKeys().hasOnly(['coins', 'lastAuction'])
        && before.coins >= trade.price && after.coins == before.coins - trade.price
        && !exists(auctionBidPath(trade.id))
        && bid.buyer == uid && bid.character == trade.character && bid.price == trade.price
        && bid.price >= auctionMinOf(trade.character) && bid.price <= auctionMaxOf(trade.character);
    }
    function isAuctionCancelBid(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let bid = get(auctionBidPath(trade.id)).data;
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'cancelBid'
        && after.diff(before).affectedKeys().hasOnly(['coins', 'lastAuction'])
        && bid.buyer == uid && bid.character == trade.character && bid.price == trade.price
        && after.coins == before.coins + bid.price && auctionBidGone(trade.id);
    }
    function isAuctionFill(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let bid = get(auctionBidPath(trade.id)).data;
      let remaining = before.characters.get(trade.character, 0) - 1;
      let buyer = auctionUserAfter(bid.buyer);
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'fill'
        && after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'lastAuction', 'auctionTrades'])
        && auctionTraded(before, after)
        && bid.buyer != uid && bid.character == trade.character && bid.price == trade.price
        && bid.price >= auctionMinOf(bid.character) && bid.price <= auctionMaxOf(bid.character)
        && remaining >= (before.get('avatar', null) == trade.character ? 1 : 0)
        && after.characters.diff(before.characters).affectedKeys().hasOnly([trade.character])
        && after.characters.get(trade.character, 0) == remaining
        && after.coins == before.coins + bid.price && auctionBidGone(trade.id)
        && validAuctionQuote(trade.character, bid.price)
        && buyer.lastAuction.action == 'filled' && buyer.lastAuction.id == trade.id
        && buyer.lastAuction.character == trade.character && buyer.lastAuction.price == trade.price
        && buyer.characters.get(trade.character, 0) == auctionUserBefore(bid.buyer).characters.get(trade.character, 0) + 1
        && buyer.coins == auctionUserBefore(bid.buyer).coins
        && buyer.get('auctionTrades', 0) == auctionUserBefore(bid.buyer).get('auctionTrades', 0) + 1;
    }
    function isAuctionFilled(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let bid = get(auctionBidPath(trade.id)).data;
      let seller = auctionUserAfter(request.auth.uid);
      return isSignedIn() && request.auth.uid != uid && auctionTrade(trade) && trade.action == 'filled'
        && after.diff(before).affectedKeys().hasOnly(['characters', 'lastAuction', 'auctionTrades'])
        && auctionTraded(before, after)
        && bid.buyer == uid && bid.character == trade.character && bid.price == trade.price
        && after.characters.diff(before.characters).affectedKeys().hasOnly([trade.character])
        && after.characters.get(trade.character, 0) == before.characters.get(trade.character, 0) + 1
        && after.coins == before.coins && auctionBidGone(trade.id)
        && seller.lastAuction.action == 'fill' && seller.lastAuction.id == trade.id
        && seller.lastAuction.character == trade.character && seller.lastAuction.price == trade.price;
    }
    function isAuctionEditList(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let listing = get(auctionListingPath(trade.id)).data;
      let next = getAfter(auctionListingPath(trade.id)).data;
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'editList'
        && after.diff(before).affectedKeys().hasOnly(['lastAuction'])
        && listing.seller == uid && listing.character == trade.character
        && next.diff(listing).affectedKeys().hasOnly(['price'])
        && next.price == trade.price && next.price != listing.price
        && next.price >= auctionMinOf(trade.character) && next.price <= auctionMaxOf(trade.character);
    }
    function isAuctionEditBid(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let bid = get(auctionBidPath(trade.id)).data;
      let next = getAfter(auctionBidPath(trade.id)).data;
      return isOwner(uid) && auctionTrade(trade) && trade.action == 'editBid'
        && after.diff(before).affectedKeys().hasOnly(['coins', 'lastAuction'])
        && bid.buyer == uid && bid.character == trade.character
        && next.diff(bid).affectedKeys().hasOnly(['price'])
        && next.price == trade.price && next.price != bid.price
        && next.price >= auctionMinOf(trade.character) && next.price <= auctionMaxOf(trade.character)
        && before.coins + bid.price >= trade.price
        && after.coins == before.coins + bid.price - trade.price;
    }
    function isAuctionProfile(uid) {
      let action = auctionUserAfter(uid).lastAuction.action;
      return action == 'list' ? isAuctionList(uid)
        : action == 'cancel' ? isAuctionCancel(uid)
        : action == 'buy' ? isAuctionBuy(uid)
        : action == 'bid' ? isAuctionBid(uid)
        : action == 'cancelBid' ? isAuctionCancelBid(uid)
        : action == 'editList' ? isAuctionEditList(uid)
        : action == 'editBid' ? isAuctionEditBid(uid)
        : action == 'fill' && isAuctionFill(uid);
    }
    function isAuctionSell(uid) {
      let before = auctionUserBefore(uid);
      let after = auctionUserAfter(uid);
      let trade = after.lastAuction;
      let listing = get(auctionListingPath(trade.id)).data;
      let buyer = auctionUserAfter(request.auth.uid);
      return isSignedIn() && request.auth.uid != uid && auctionTrade(trade) && trade.action == 'sell'
        && after.diff(before).affectedKeys().hasOnly(['coins', 'lastAuction', 'auctionTrades'])
        && auctionTraded(before, after)
        && listing.seller == uid && listing.character == trade.character && listing.price == trade.price
        && after.coins == before.coins + listing.price && auctionListingGone(trade.id)
        && buyer.lastAuction.action == 'buy' && buyer.lastAuction.id == trade.id
        && buyer.lastAuction.character == trade.character && buyer.lastAuction.price == trade.price;
    }
    match /auctionListings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isAuctionList(request.auth.uid)
        && request.resource.data.keys().hasOnly(['seller', 'sellerName', 'character', 'price', 'createdAt'])
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.sellerName == auctionUserAfter(request.auth.uid).get('nickname', auctionUserAfter(request.auth.uid).username)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isAuctionEditList(request.auth.uid)
        && request.resource.data.keys().hasOnly(['seller', 'sellerName', 'character', 'price', 'createdAt']);
      allow delete: if isSignedIn() && (
        isAuctionCancel(request.auth.uid)
        || isAuctionBuy(request.auth.uid)
        || (resource.data.seller == request.auth.uid && isGone(resource.data.seller))
      );
    }
    match /auctionBids/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isAuctionBid(request.auth.uid)
        && request.resource.data.keys().hasOnly(['buyer', 'buyerName', 'character', 'price', 'createdAt'])
        && request.resource.data.buyer == request.auth.uid
        && request.resource.data.buyerName == auctionUserAfter(request.auth.uid).get('nickname', auctionUserAfter(request.auth.uid).username)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isAuctionEditBid(request.auth.uid)
        && request.resource.data.keys().hasOnly(['buyer', 'buyerName', 'character', 'price', 'createdAt']);
      allow delete: if isSignedIn() && (
        isAuctionCancelBid(request.auth.uid)
        || isAuctionFill(request.auth.uid)
        || (resource.data.buyer == request.auth.uid && isGone(resource.data.buyer))
      );
    }
    match /auctionQuotes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAuctionBuy(request.auth.uid) || isAuctionFill(request.auth.uid))
        && id == auctionUserAfter(request.auth.uid).lastAuction.character;
      allow update: if isSignedIn() && (
        ((isAuctionBuy(request.auth.uid) || isAuctionFill(request.auth.uid))
          && id == auctionUserAfter(request.auth.uid).lastAuction.character)
        || isAuctionSettle(id)
      );
    }
