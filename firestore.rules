chars.get('cats_hidden_siamese', 0) > 0 && chars.get('cats_hidden_turkish_angora', 0) > 0) : id == 'rare' ? (chars.get('rare_mouse', 0) > 0 && chars.get('rare_cow', 0) > 0 && chars.get('rare_tiger', 0) > 0 && chars.get('rare_rabbit', 0) > 0 && chars.get('rare_dragon', 0) > 0 && chars.get('rare_snake', 0) > 0 && chars.get('rare_horse', 0) > 0 && chars.get('rare_sheep', 0) > 0 && chars.get('rare_monkey', 0) > 0 && chars.get('rare_chicken', 0) > 0 && chars.get('rare_dog', 0) > 0 && chars.get('rare_pig', 0) > 0) : id == 'premium' ? (chars.get('premium_mouse', 0) > 0 && chars.get('premium_cow', 0) > 0 && chars.get('premium_tiger', 0) > 0 && chars.get('premium_rabbit', 0) > 0 && chars.get('premium_dragon', 0) > 0 && chars.get('premium_snake', 0) > 0 && chars.get('premium_horse', 0) > 0 && chars.get('premium_sheep', 0) > 0 && chars.get('premium_monkey', 0) > 0 && chars.get('premium_chicken', 0) > 0 && chars.get('premium_dog', 0) > 0 && chars.get('premium_pig', 0) > 0) : id == 'baby' ? (chars.get('baby_mouse', 0) > 0 && chars.get('baby_cow', 0) > 0 && chars.get('baby_tiger', 0) > 0 && chars.get('baby_rabbit', 0) > 0 && chars.get('baby_dragon', 0) > 0 && chars.get('baby_snake', 0) > 0 && chars.get('baby_horse', 0) > 0 && chars.get('baby_sheep', 0) > 0 && chars.get('baby_monkey', 0) > 0 && chars.get('baby_chicken', 0) > 0 && chars.get('baby_dog', 0) > 0 && chars.get('baby_pig', 0) > 0 && chars.get('baby_abyssinian', 0) > 0 && chars.get('baby_american_shorthair', 0) > 0 && chars.get('baby_bengal', 0) > 0 && chars.get('baby_british_shorthair', 0) > 0 && chars.get('baby_maine_coon', 0) > 0 && chars.get('baby_persian', 0) > 0 && chars.get('baby_ragdoll', 0) > 0 && chars.get('baby_russian_blue', 0) > 0 && chars.get('baby_siamese', 0) > 0 && chars.get('baby_turkish_angora', 0) > 0) : id == 'epic' ? (chars.get('epic_mouse', 0) > 0 && chars.get('epic_cow', 0) > 0 && chars.get('epic_tiger', 0) > 0 && chars.get('epic_rabbit', 0) > 0 && chars.get('epic_dragon', 0) > 0 && chars.get('epic_snake', 0) > 0 && chars.get('epic_horse', 0) > 0 && chars.get('epic_sheep', 0) > 0 && chars.get('epic_monkey', 0) > 0 && chars.get('epic_chicken', 0) > 0 && chars.get('epic_dog', 0) > 0 && chars.get('epic_pig', 0) > 0) : id == 'unique' ? (chars.get('unique_mouse', 0) > 0 && chars.get('unique_cow', 0) > 0 && chars.get('unique_tiger', 0) > 0 && chars.get('unique_rabbit', 0) > 0 && chars.get('unique_dragon', 0) > 0 && chars.get('unique_snake', 0) > 0 && chars.get('unique_horse', 0) > 0 && chars.get('unique_sheep', 0) > 0 && chars.get('unique_monkey', 0) > 0 && chars.get('unique_chicken', 0) > 0 && chars.get('unique_dog', 0) > 0 && chars.get('unique_pig', 0) > 0) : id == 'legendary' ? (chars.get('legendary_mouse', 0) > 0 && chars.get('legendary_cow', 0) > 0 && chars.get('legendary_tiger', 0) > 0 && chars.get('legendary_rabbit', 0) > 0 && chars.get('legendary_dragon', 0) > 0 && chars.get('legendary_snake', 0) > 0 && chars.get('legendary_horse', 0) > 0 && chars.get('legendary_sheep', 0) > 0 && chars.get('legendary_monkey', 0) > 0 && chars.get('legendary_chicken', 0) > 0 && chars.get('legendary_dog', 0) > 0 && chars.get('legendary_pig', 0) > 0) : id == 'hidden' ? (chars.get('hidden_mouse', 0) > 0 && chars.get('hidden_cow', 0) > 0 && chars.get('hidden_tiger', 0) > 0 && chars.get('hidden_rabbit', 0) > 0 && chars.get('hidden_dragon', 0) > 0 && chars.get('hidden_snake', 0) > 0 && chars.get('hidden_horse', 0) > 0 && chars.get('hidden_sheep', 0) > 0 && chars.get('hidden_monkey', 0) > 0 && chars.get('hidden_chicken', 0) > 0 && chars.get('hidden_dog', 0) > 0 && chars.get('hidden_pig', 0) > 0) : false);
    }
    // Permanent medals are independent from ticket achievements and cannot be overwritten.
    match /users/{uid}/medals/{medalId} {
      function earned() {
        let p = get(/databases/$(database)/documents/users/$(uid)).data;
        let parts = medalId.split(':');
        return parts.size() == 2 && (
          (parts[0] == 'collection_complete' && isMedalCollection(parts[1], p.characters))
          || (medalId == 'steps:10000' && p.get('steps', 0) >= 10000)
          || (medalId == 'steps:100000' && p.get('steps', 0) >= 100000)
          || (medalId == 'draws:100' && p.drawCount >= 100)
          || (parts[0] in ['hatchCount', 'evolveCount', 'fuseCount', 'recycleCount'] && parts[1] == '10' && p.get(parts[0], 0) >= 10));
      }
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && earned() && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      allow delete: if isOwner(uid) && isGone(uid);
    }

    // A display preference does not award a medal. Live rankings determine crown ownership.
    match /medalDisplays/{uid} {
      function validDisplay() {
        let d = request.resource.data;
        let id = d.medalId;
        return d.keys().hasAll(['medalId', 'updatedAt']) && d.keys().hasOnly(['medalId', 'updatedAt'])
          && d.updatedAt == request.time && exists(/databases/$(database)/documents/users/$(uid))
          && (id == null || (id is string && (id in ["ranking:steps","ranking:hatchCount","ranking:evolveCount","ranking:fuseCount","ranking:recycleCount","ranking:grade:N","ranking:grade:E","ranking:grade:R","ranking:grade:EP","ranking:grade:U","ranking:grade:L","ranking:grade:H"] || exists(/databases/$(database)/documents/users/$(uid)/medals/$(id)))));
      }
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && validDisplay();
      allow delete: if isOwner(uid);
    }

    match /bonds/{uid} {
      function validRecord(r) {
        return r.keys().hasAll(['seconds', 'steps', 'since', 'stepStart']) && r.keys().hasOnly(['seconds', 'steps', 'since', 'stepStart'])
          && r.seconds is int && r.seconds >= 0 && r.steps is int && r.steps >= 0 && r.stepStart is int && r.stepStart >= 0;
      }
      function validClose(before, after, old, total) {
        let b = before.get(old, {'seconds': 0, 'steps': 0, 'since': null, 'stepStart': 0});
        let a = after[old];
        return validRecord(a) && a.since == null && a.stepStart == b.stepStart
          && a.steps == b.steps + (total - b.stepStart >= 0 ? total - b.stepStart : 0)
          && a.seconds >= b.seconds && a.seconds <= b.seconds + (request.time - b.since).seconds() + 5
          && a.seconds >= b.seconds + (request.time - b.since).seconds() - 5;
      }
      function validOpen(before, after, active, total) {
        let b = before.get(active, {'seconds': 0, 'steps': 0});
        let a = after[active];
        return validRecord(a) && a.seconds == b.seconds && a.steps == b.steps && a.since == request.time && a.stepStart == total;
      }
      function validBond() {
        let b = resource == null ? {'animals': {}, 'active': null} : resource.data;
        let a = request.resource.data;
        let p = get(/databases/$(database)/documents/users/$(uid)).data;
        let next = getAfter(/databases/$(database)/documents/users/$(uid)).data.get('avatar', null);
        let old = b.active;
        let total = p.get('steps', 0);
        return a.keys().hasAll(['animals', 'active', 'updatedAt']) && a.keys().hasOnly(['animals', 'active', 'updatedAt'])
          && a.animals is map && a.active == next && a.updatedAt == request.time
          && (next == null || p.characters.get(next, 0) > 0)
          && a.animals.diff(b.animals).affectedKeys().hasOnly([old, next])
          && (old == null || (old != next && validClose(b.animals, a.animals, old, total)))
          && (next == null || validOpen(b.animals, a.animals, next, total));
      }
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validBond();
      allow delete: if isOwner(uid) && isGone(uid);
    }

    function friendshipKey(a, b) { return a < b ? a + ':' + b : b + ':' + a; }
    function areFriends(a, b) {
      let path = /databases/$(database)/documents/friendships/$(friendshipKey(a, b));
      return exists(path) && get(path).data.status == 'accepted';
    }
    match /friendships/{id} {
      function identity(uid, name, avatar) {
        let p = get(/databases/$(database)/documents/users/$(uid)).data;
        return name == p.get('nickname', p.username) && avatar == p.get('avatar', null);
      }
      function validRequest() {
        let d = request.resource.data;
        return d.keys().hasAll(['members', 'sender', 'recipient', 'status', 'senderName', 'senderAvatar', 'recipientName', 'recipientAvatar', 'createdAt', 'updatedAt', 'requestReadAt', 'acceptedReadAt'])
          && d.keys().hasOnly(['members', 'sender', 'recipient', 'status', 'senderName', 'senderAvatar', 'recipientName', 'recipientAvatar', 'createdAt', 'updatedAt', 'requestReadAt', 'acceptedReadAt'])
          && d.sender == request.auth.uid && d.sender != d.recipient && d.recipient is string
          && d.members is list && d.members.size() == 2 && d.members[0] < d.members[1] && d.members.hasAll([d.sender, d.recipient])
          && id == friendshipKey(d.sender, d.recipient) && d.status == 'pending'
          && d.createdAt == request.time && d.updatedAt == request.time && d.requestReadAt == null && d.acceptedReadAt == null
          && identity(d.sender, d.senderName, d.senderAvatar) && identity(d.recipient, d.recipientName, d.recipientAvatar);
      }
      function validUpdate() {
        let b = resource.data;
        let d = request.resource.data;
        let changed = d.diff(b).affectedKeys();
        return (request.auth.uid == b.recipient && b.status == 'pending' && d.status == 'accepted'
            && changed.hasOnly(['status', 'recipientName', 'recipientAvatar', 'updatedAt', 'requestReadAt'])
            && d.updatedAt == request.time && d.requestReadAt == request.time && identity(b.recipient, d.recipientName, d.recipientAvatar))
          || (request.auth.uid == b.recipient && changed.hasOnly(['requestReadAt']) && d.requestReadAt == request.time)
          || (request.auth.uid == b.sender && b.status == 'accepted' && changed.hasOnly(['acceptedReadAt']) && d.acceptedReadAt == request.time);
      }
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && validRequest();
      allow update: if isSignedIn() && validUpdate();
      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;
    }
    match /mapPreferences/{uid} {
      function validPreference() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/locations/$(uid);
        return d.keys().hasAll(['sharing', 'audience', 'updatedAt']) && d.keys().hasOnly(['sharing', 'audience', 'updatedAt'])
          && d.sharing is bool && d.audience in ['public', 'friends'] && d.updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(uid))
          && (!existsAfter(path) || (d.sharing && getAfter(path).data.get('audience', 'public') == d.audience));
      }
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPreference();
      allow delete: if isOwner(uid) && isGone(uid);
    }
    function mayShareLocation(uid) {
      let path = /databases/$(database)/documents/mapPreferences/$(uid);
      let p = existsAfter(path) ? getAfter(path).data : {'sharing': true, 'audience': 'public'};
      let d = request.resource.data;
      return p.sharing && d.get('audience', 'public') == p.audience;
    }

    match /users/{uid}/stepSync/{device} {
      function validCursor() {
        let b = resource == null ? {'epoch': '', 'count': 0, 'credited': 0} : resource.data;
        let d = request.resource.data;
        let before = get(/databases/$(database)/documents/users/$(uid)).data;
        let after = getAfter(/databases/$(database)/documents/users/$(uid)).data;
        let added = d.credited - b.credited;
        return d.keys().hasAll(['epoch', 'count', 'credited', 'updatedAt']) && d.keys().hasOnly(['epoch', 'count', 'credited', 'updatedAt'])
          && d.epoch is string && d.epoch.size() > 0 && d.epoch.size() <= 100
          && d.count is int && d.count >= 0 && d.credited is int && added >= 0
          && (d.epoch == b.epoch ? d.count >= b.count && added <= d.count - b.count : added <= d.count)
          && d.updatedAt == request.time && added == after.get('steps', 0) - before.get('steps', 0);
      }
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validCursor();
      allow delete: if isOwner(uid) && isGone(uid);
    }

    function isCatalogAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled == true;
    }
    match /gachaCatalog/{id} {
      allow read: if request.auth != null;
      allow create, update: if id == 'live' && isCatalogAdmin()
        && request.resource.data.schema == 1 && request.resource.data.collections is list
        && request.resource.data.collections.size() > 0 && request.resource.data.collections.size() <= 80
        && request.resource.data.version == (resource == null ? 1 : resource.data.version + 1)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    match /administrators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /gachaCatalogVersions/{id} {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled;
      allow create: if isCatalogAdmin() && request.resource.data.updatedAt == request.time
        && request.resource.data == getAfter(/databases/$(database)/documents/gachaCatalog/live).data;
      allow update, delete: if false;
    }
    match /gachaBanners/{id} {
      allow read: if request.auth != null;
      allow create, update: if isCatalogAdmin() && request.resource.data.version == getAfter(/databases/$(database)/documents/gachaCatalog/live).data.version;
    }
    match /gachaCharacters/{id} {
      allow read: if request.auth != null;
      allow create, update: if isCatalogAdmin();
    }
    match /gachaCollections/{id} {
      allow read: if request.auth != null;
      allow create, update: if isCatalogAdmin();
    }
    match /gachaImages/{id} {
      allow read: if request.auth != null;
      allow create: if isCatalogAdmin() && request.resource.data.keys().hasOnly(['data', 'createdAt'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 350000
        && request.resource.data.data.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isNewProfile();
      allow update: if isOwner(uid) && isProfileUpdate(uid);
      // Leaving: the profile goes first, then its history (see isGone).
      allow delete: if isOwner(uid);
    }

    // The breeding nest: at most three eggs, one per slot. An egg only goes away by hatching.
    match /users/{uid}/eggs/{slot} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && slot in ['0', '1', '2'] && isEgg(uid);
      allow delete: if isOwner(uid)
        && (getAfter(/databases/$(database)/documents/users/$(uid)).data.get('lastHatch', '') == slot || isGone(uid));
    }

    // Steps walked with each character as the map avatar; evolving spends them.
    match /companions/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && (isCompanionSteps(uid) || isEvolveSpend(uid));
      allow delete: if isOwner(uid);
    }

    // Route each operation by its changed counter before evaluating expensive inventory rules.
    function isProfileUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasAny(['drawCount']) && isLegalDraw())
        || (changed.hasAny(['lastClaim']) && isClaim(uid))
        || (changed.hasAny(['steps']) && isStepReward())
        || (changed.hasAny(['hatchCount']) && isHatch(uid))
        || (changed.hasAny(['username']) && isUsernameChange())
        || (changed.hasAny(['nickname']) && isNicknameChange())
        || (changed.hasAny(['fuseCount']) && isFuse())
        || (changed.hasAny(['recycleCount']) && isRecycle())
        || (changed.hasAny(['evolveCount']) && isEvolve(uid))
        || (changed.hasOnly(['avatar']) && isAvatarChange())
        || (changed.hasAny(['characters']) && isSale());
    }

    function isSale() {
      let before = resource.data;
      let after = request.resource.data;
      let sale = after.lastSale;
      let c = sale.character;
      let n = sale.quantity;
      let prices = {"N":0,"R":1,"EP":10,"U":30,"L":50,"E":1,"H":100};
      let price = prices.get(gradeOf(c), -1);
      let remaining = before.characters.get(c, 0) - n;
      return after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'lastSale'])
        && sale.keys().hasOnly(['character', 'quantity'])
        && c is string && n is int && n > 0 && price >= 0
        && remaining >= (before.get('avatar', null) == c ? 1 : 0)
        && after.characters.diff(before.characters).affectedKeys().hasOnly([c])
        && after.characters.get(c, 0) == remaining
        && after.coins == before.coins + price * n;
    }

    // Crafting writes lastCraft { inputs, output } with its counter. Odds are rolled on the phone, so these
    // only check that the outcome is possible.

    // Fusion: any two characters of one grade plus that grade's coins become a pool animal one tier up, or
    // nothing on failure.
    function isFuse() {
      let before = resource.data;
      let after = request.resource.data;
      let craft = after.lastCraft;
      let c = craft.inputs[0];
      let d = craft.inputs[1];
      let a = after.characters;
      let b = before.characters;
      let fee = fusionCoins(gradeOf(c));
      return after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'fuseCount', 'lastCraft'])
        && after.get('fuseCount', 0) == before.get('fuseCount', 0) + 1
        && craft.keys().hasOnly(['inputs', 'output']) && craft.inputs == [c, d]
        && gradeOf(c) == gradeOf(d)
        && fee >= 0 && before.coins - after.coins == fee && after.coins >= 0
        && (c == d
          ? a.get(c, 0) == b.get(c, 0) - 2
          : a.get(c, 0) == b.get(c, 0) - 1 && a.get(d, 0) == b.get(d, 0) - 1)
        && a.get(c, 0) >= 0 && a.get(d, 0) >= 0
        && a.get(c, 0) >= (before.get('avatar', null) == c ? 1 : 0)
        && a.get(d, 0) >= (before.get('avatar', null) == d ? 1 : 0)
        && (craft.output == null
          ? a.diff(b).affectedKeys().hasOnly([c, d])
          : poolTier(craft.output) == tierOf(c) + 1
            && a.diff(b).affectedKeys().hasOnly([c, d, craft.output])
            && a.get(craft.output, 0) == b.get(craft.output, 0) + 1);
    }

    // Recycling: 10 characters from the crafting tiers become one pool animal of any tier (higher tiers
    // are rarer the further they are above the lowest input, down to tiny chances).
    function isRecycle() {
      let before = resource.data;
      let after = request.resource.data;
      let inputs = after.lastCraft.inputs;
      let out = after.lastCraft.output;
      let a = after.characters;
      let b = before.characters;
      let t = poolTier(out);
      let allowed = '^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_rare_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_epic_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_unique_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_legendary_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig|abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$';
      return after.diff(before).affectedKeys().hasOnly(['characters', 'recycleCount', 'lastCraft'])
        && after.get('recycleCount', 0) == before.get('recycleCount', 0) + 1
        && after.lastCraft.keys().hasOnly(['inputs', 'output'])
        && inputs is list && inputs.size() == 10 && out is string && t > 0
        && a.diff(b).affectedKeys().hasOnly(inputs.concat([out]))
        && a.get(out, 0) - b.get(out, 0) == 1 - (10 - inputs.removeAll([out]).size())
        && recycled(a, b, inputs, out, allowed, 0, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 1, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 2, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 3, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 4, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 5, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 6, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 7, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 8, before.get('avatar', null))
        && recycled(a, b, inputs, out, allowed, 9, before.get('avatar', null));
    }

    function recycled(a, b, inputs, out, allowed, i, avatar) {
      let c = inputs[i];
      let spent = 10 - inputs.removeAll([c]).size();
      return c.matches(allowed) && a.get(c, 0) >= 0
        && b.get(c, 0) - spent >= (avatar == c ? 1 : 0)
        && (c == out || a.get(c, 0) - b.get(c, 0) == -spent);
    }

    // Evolution: one character becomes the same animal in the next collection, paid with coins and the
    // steps walked with it (spent from companions in the same write). The avatar may follow it.
    function isEvolve(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let c = after.lastCraft.inputs[0];
      let out = evolveTarget(c);
      let a = after.characters;
      let b = before.characters;
      let need = evolveSteps(gradeOf(c));
      let path = /databases/$(database)/documents/companions/$(uid);
      return after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'evolveCount', 'lastCraft', 'avatar'])
        && after.get('evolveCount', 0) == before.get('evolveCount', 0) + 1
        && after.lastCraft == { 'inputs': [c], 'output': out }
        && out != '' && need > 0
        && before.coins - after.coins == evolveCoins(gradeOf(c)) && after.coins >= 0
        && a.diff(b).affectedKeys().hasOnly([c, out])
        && a.get(c, 0) == b.get(c, 0) - 1 && a.get(c, 0) >= 0
        && a.get(out, 0) == b.get(out, 0) + 1
        && (after.get('avatar', null) == before.get('avatar', null) || after.avatar == out)
        && get(path).data.steps.get(c, 0) >= need
        && getAfter(path).data.steps.get(c, 0) == get(path).data.steps.get(c, 0) - need;
    }

    function isEvolveSpend(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      let c = getAfter(path).data.lastCraft.inputs[0];
      let before = resource.data.steps;
      let after = request.resource.data.steps;
      return getAfter(path).data.get('evolveCount', 0) == get(path).data.get('evolveCount', 0) + 1
        && request.resource.data.keys().hasOnly(['steps'])
        && after.diff(before).affectedKeys().hasOnly([c])
        && after.get(c, 0) == before.get(c, 0) - evolveSteps(gradeOf(c));
    }

    // Public leaderboard entry, a copy of the player's profile numbers; any signed-in player can read it.
    match /rankings/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isRanking(uid);
      allow delete: if isOwner(uid);
    }

    function isRanking(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let d = request.resource.data;
      let counts = ['hatchCount', 'evolveCount', 'fuseCount', 'recycleCount'];
      let fields = ['username', 'avatar', 'steps', 'characters', 'updatedAt'].concat(counts);
      return d.keys().hasOnly(fields.concat(['nickname'])) && d.keys().hasAll(fields)
        && d.username == user.username
        && d.get('nickname', null) == user.get('nickname', null)
        && d.avatar == user.get('avatar', null)
        && d.steps == user.get('steps', 0)
        && d.characters == user.characters
        && d.hatchCount == user.get('hatchCount', 0)
        && d.evolveCount == user.get('evolveCount', 0)
        && d.fuseCount == user.get('fuseCount', 0)
        && d.recycleCount == user.get('recycleCount', 0)
        && d.updatedAt == request.time;
    }

    // History may only be cleared once its profile is deleted, so claims can't be wiped and claimed again.
    function isGone(uid) {
      return !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    // Laying an egg is free and keeps both parents. Only grades with a hatch time in rewards.json can breed.
    function isEgg(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let egg = request.resource.data;
      let p = egg.parents;
      let fields = ['parents', 'child', 'grade', 'createdAt'];
      return egg.keys().hasOnly(fields) && egg.keys().hasAll(fields)
        && p is list && p.size() == 2 && p[0] is string && p[1] is string
        && user.characters.get(p[0], 0) > 0
        && user.characters.get(p[1], 0) > (p[0] == p[1] ? 1 : 0)
        && hatchMinutes(gradeOf(p[0])) > 0 && hatchMinutes(gradeOf(p[1])) > 0
        && (isBaby(egg.child, p) || isPoolChild(egg.child, p))
        && egg.grade == gradeOf(egg.child)
        && egg.createdAt == request.time;
    }

    // Hatching adds the child and deletes its egg. Before hatchMinutes have passed it costs
    // 1 coin(s) per minute left; one extra minute is allowed for clock drift.
    function isHatch(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let path = /databases/$(database)/documents/users/$(uid)/eggs/$(after.lastHatch);
      let egg = get(path).data;
      let left = (egg.createdAt + duration.value(hatchMinutes(egg.grade), 'm') - request.time).seconds();
      let cost = left > 0 ? math.ceil(left / 60.0) * 1 : 0;
      let paid = before.coins - after.coins;
      return after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'lastHatch', 'hatchCount'])
        && after.lastHatch in ['0', '1', '2']
        && after.hatchCount == before.get('hatchCount', 0) + 1
        && !existsAfter(path)
        && after.characters.diff(before.characters).affectedKeys().hasOnly([egg.child])
        && after.characters.get(egg.child, 0) == before.characters.get(egg.child, 0) + 1
        && after.coins >= 0
        && paid >= cost && paid <= cost + 1;
    }

    // Only the current avatar's count may grow. Steps come from the phone, so amounts can't be verified.
    function isCompanionSteps(uid) {
      let avatar = get(/databases/$(database)/documents/users/$(uid)).data.get('avatar', null);
      let before = request.method == 'create' ? {} : resource.data.steps;
      let after = request.resource.data;
      return after.keys().hasOnly(['steps'])
        && avatar is string
        && after.steps.diff(before).affectedKeys().hasOnly([avatar])
        && after.steps[avatar] is int && after.steps[avatar] > before.get(avatar, 0);
    }

    // Where each player is on the map; any signed-in player can see everyone who shares.
    match /locations/{uid} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid == uid || resource.data.get('audience', 'public') == 'public' || areFriends(request.auth.uid, uid));
      allow list: if isSignedIn() && resource.data.audience == 'public';
      allow create, update: if isOwner(uid) && isLocation(uid) && mayShareLocation(uid);
      allow delete: if isOwner(uid);
    }

    // Write-once history: users/{uid}/draws/{drawCount after the draw}, saved alongside each draw.
    match /users/{uid}/draws/{drawId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isDrawLog(uid, drawId);
      allow delete: if isOwner(uid) && isGone(uid);
    }

    // Write-once achievement claims: users/{uid}/claims/{achievement id}, saved alongside the tickets.
    match /users/{uid}/claims/{claimId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isClaimLog(uid, claimId);
      allow delete: if isOwner(uid) && isGone(uid);
    }

    function isDrawLog(uid, drawId) {
      let user = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let log = request.resource.data;
      return drawId == string(user.drawCount)
        && log.keys().hasOnly(['banner', 'picks', 'coins', 'tickets', 'rewards', 'createdAt'])
        && log.banner == user.lastBanner
        && log.picks == user.lastDraw
        && log.createdAt == request.time;
    }

    // Claiming an achievement adds its tickets once; the claim document makes it permanent.
    function isClaim(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let id = after.lastClaim;
      let reward = claimReward(id.split(':'), before);
      return after.diff(before).affectedKeys().hasOnly(['tickets', 'lastClaim'])
        && id is string
        && !exists(/databases/$(database)/documents/users/$(uid)/claims/$(id))
        && existsAfter(/databases/$(database)/documents/users/$(uid)/claims/$(id))
        && reward > 0
        && after.tickets == before.get('tickets', 0) + reward;
    }

    function isClaimLog(uid, claimId) {
      let user = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let log = request.resource.data;
      return user.lastClaim == claimId
        && log.keys().hasOnly(['tickets', 'label', 'createdAt'])
        && log.tickets == user.tickets - get(/databases/$(database)/documents/users/$(uid)).data.get('tickets', 0)
        && log.createdAt == request.time;
    }

    // The name and face shown on the map must match the player's profile.
    function isLocation(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let d = request.resource.data;
      let fields = ['username', 'avatar', 'lat', 'lng', 'updatedAt'];
      return d.keys().hasOnly(fields.concat(['nickname', 'audience'])) && d.keys().hasAll(fields)
        && d.get('audience', 'public') in ['public', 'friends']
        && d.username == user.username
        && d.get('nickname', null) == user.get('nickname', null)
        && d.avatar == user.get('avatar', null)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.updatedAt == request.time;
    }

  // First sign-in: exactly 100 coins, username tied to the account's email. With a birthday
  // (YYYY-MM-DD) the player starts with one of their birth year's zodiac animal, otherwise nothing.
  function isNewProfile() {
    let data = request.resource.data;
    let fields = ['username', 'coins', 'characters', 'drawCount', 'createdAt'];
    return data.keys().hasOnly(fields.concat(['birthday', 'nickname'])) && data.keys().hasAll(fields)
      && (!data.keys().hasAny(['nickname']) || isNickname(data.nickname))
      && data.username is string
      && data.username.matches('^[a-z0-9_]{4,20}$')
      && request.auth.token.email == data.username + '@users.animalsrun.local'
      && data.coins == 100
      && (data.keys().hasAny(['birthday']) ? isStarter(data.characters, data.birthday) : data.characters == {})
      && data.drawCount == 0
      && data.createdAt == request.time;
  }

  function isStarter(characters, birthday) {
    return birthday is string
      && birthday.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
      && int(birthday.split('-')[0]) <= request.time.year()
      && characters == zodiacStarter(['mouse', 'cow', 'tiger', 'rabbit', 'dragon', 'snake', 'horse', 'sheep', 'monkey', 'chicken', 'dog', 'pig'][(zodiacYear(birthday.split('-')) - 4) % 12]);
  }

  // Born before that year's Seollal (MMDD per year from 1900) means the previous zodiac year.
  function zodiacYear(ymd) {
    let year = int(ymd[0]);
    let seollal = '0131,0219,0208,0129,0216,0204,0125,0213,0202,0122,0210,0130,0218,0206,0126,0214,0204,0123,0211,0201,0220,0208,0128,0216,0205,0124,0213,0202,0123,0210,0130,0217,0206,0126,0214,0204,0124,0211,0131,0219,0208,0127,0215,0205,0126,0213,0202,0122,0210,0129,0217,0206,0127,0214,0204,0124,0212,0131,0219,0208,0128,0215,0205,0125,0213,0202,0122,0209,0130,0217,0206,0127,0215,0203,0123,0211,0131,0218,0207,0128,0216,0205,0125,0213,0202,0220,0209,0129,0218,0206,0127,0215,0204,0123,0210,0131,0219,0208,0128,0216,0205,0124,0212,0201,0122,0209,0129,0218,0207,0126,0214,0203,0123,0210,0131,0219,0208,0128,0216,0205,0125,0212,0201,0122,0210,0129,0217,0207,0127,0213,0203,0123,0211,0131,0219,0208,0128,0215,0204,0124,0212,0201,0122,0210,0130,0217,0206,0126,0214,0202,0123,0211,0201,0219,0208,0128,0215,0204,0124,0212,0202,0122,0209,0129,0217,0205,0126,0214,0203,0123,0211,0131,0219,0207,0127,0215,0205,0124,0212,0202,0122,0209,0129,0217,0206,0126,0214,0203,0124,0211,0130,0218,0208,0127,0215,0205,0125,0212,0201,0121'.split(',')[year - 1900];
    return int(ymd[1] + ymd[2]) < int(seollal) ? year - 1 : year;
  }

  function zodiacStarter(id) {
    return id == 'mouse' ? { 'mouse': 1 }
      : id == 'cow' ? { 'cow': 1 }
      : id == 'tiger' ? { 'tiger': 1 }
      : id == 'rabbit' ? { 'rabbit': 1 }
      : id == 'dragon' ? { 'dragon': 1 }
      : id == 'snake' ? { 'snake': 1 }
      : id == 'horse' ? { 'horse': 1 }
      : id == 'sheep' ? { 'sheep': 1 }
      : id == 'monkey' ? { 'monkey': 1 }
      : id == 'chicken' ? { 'chicken': 1 }
      : id == 'dog' ? { 'dog': 1 }
      : id == 'pig' ? { 'pig': 1 }
      : {};
  }

  // Walking: steps is the running total of counted steps, and every 50 of them is one coin.
  // Step counts come from the phone, so they can't be verified here.
  function isStepReward() {
    let before = resource.data;
    let after = request.resource.data;
    let steps = before.get('steps', 0);
    return after.diff(before).affectedKeys().hasOnly(['coins', 'steps'])
      && after.steps is int && after.steps > steps
      && after.coins == before.coins
        + math.floor(after.steps / 50) - math.floor(steps / 50);
  }

  // The map avatar is one of the player's own characters, or null for none.
  function isAvatarChange() {
    let after = request.resource.data;
    return after.diff(resource.data).affectedKeys().hasOnly(['avatar'])
      && (after.avatar == null || (after.avatar is string && resource.data.characters.get(after.avatar, 0) > 0));
  }

  // A new id follows the account's email, which Firebase Auth keeps unique.
  function isUsernameChange() {
    let after = request.resource.data;
    return after.diff(resource.data).affectedKeys().hasOnly(['username'])
      && after.username is string
      && after.username.matches('^[a-z0-9_]{4,20}$')
      && request.auth.token.email == after.username + '@users.animalsrun.local';
  }

  // The name shown to other players; unlike the id it needn't be unique.
  function isNicknameChange() {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
      && isNickname(request.resource.data.nickname);
  }

  function isNickname(n) {
    return n is string && n.matches('^[가-힣a-zA-Z0-9_]{2,10}$');
  }

  function gradeOf(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig|abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 'N'
      : c.matches('^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_rare_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'R'
      : c.matches('^cats_epic_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'EP'
      : c.matches('^cats_unique_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'U'
      : c.matches('^cats_legendary_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'L'
      : c.matches('^autumn_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'E'
      : c.matches('^cats_hidden_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'H'
      : (exists(/databases/$(database)/documents/gachaCharacters/$(c)) ? get(/databases/$(database)/documents/gachaCharacters/$(c)).data.grade : '');
  }

  function hatchMinutes(g) {
    return g == 'N' ? 60
      : g == 'R' ? 720
      : g == 'EP' ? 1440
      : g == 'U' ? 2880
      : g == 'L' ? 4320
      : -1;
  }

  // Crafting tier (position in rewards.json crafting.tiers, from 1) of any character, or 0 outside the tiers.
  function tierOf(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig|abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 1
      : c.matches('^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_rare_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 2
      : c.matches('^cats_epic_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 3
      : c.matches('^cats_unique_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 4
      : c.matches('^cats_legendary_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 5
      : 0;
  }

  // The same, for animals crafting can produce (crafting.pool).
  function poolTier(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 1
      : c.matches('^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_rare_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 2
      : c.matches('^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_epic_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 3
      : c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_unique_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 4
      : c.matches('^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_legendary_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 5
      : 0;
  }

  // The animal behind an id, e.g. 'tiger' for 'sea_tiger'.
  function speciesOf(c) {
    return c.replace('^(cats_legendary|cats_unique|cats_hidden|cats_rare|cats_epic|legendary|premium|autumn|unique|hidden|cats|rare|baby|epic|sea)_', '');
  }

  // 10% of eggs hold the baby version of a parent's animal.
  function isBaby(child, p) {
    return child.matches('^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig|abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$')
      && (child == 'baby_' + speciesOf(p[0]) || child == 'baby_' + speciesOf(p[1]));
  }

  // Otherwise a pool animal no higher than one of the parents (picked at random on the phone).
  function isPoolChild(child, p) {
    let t = poolTier(child);
    return t > 0 && (t <= tierOf(p[0]) || t <= tierOf(p[1]));
  }

  function evolveTarget(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'rare_' + speciesOf(c)
      : c.matches('^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'epic_' + speciesOf(c)
      : c.matches('^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'unique_' + speciesOf(c)
      : c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'legendary_' + speciesOf(c)
      : c.matches('^cats_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 'cats_rare_' + speciesOf(c)
      : c.matches('^cats_rare_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 'cats_epic_' + speciesOf(c)
      : c.matches('^cats_epic_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 'cats_unique_' + speciesOf(c)
      : c.matches('^cats_unique_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$') ? 'cats_legendary_' + speciesOf(c)
      : '';
  }

  function evolveSteps(g) {
    return g == 'N' ? 3000
      : g == 'R' ? 6000
      : g == 'EP' ? 12000
      : g == 'U' ? 24000
      : -1;
  }

  function evolveCoins(g) {
    return g == 'N' ? 10
      : g == 'R' ? 30
      : g == 'EP' ? 60
      : g == 'U' ? 120
      : -1;
  }

  function fusionCoins(g) {
    return g == 'N' ? 50
      : g == 'R' ? 80
      : g == 'EP' ? 200
      : g == 'U' ? 400
      : -1;
  }

  // Every draw also writes lastDraw (the ids drawn, in order) and lastBanner. Rules cap evaluation at
  // 1000 expressions per request (a list literal costs one per element), so checks walk the at most 10 picks.
  // A draw paid with 0 coins spends one free ticket per pick instead (only on banners costing at most
  // 10 coins per draw).
  // gradeCounts (characters drawn per grade) only has to grow by the number of picks in total: checking each
  // pick's grade doesn't fit the budget, and every grade pays the same per-100 reward, so shifting counts
  // between grades gains almost nothing.
  function isLegalDraw() {
    let before = resource.data;
    let after = request.resource.data;
    let picks = after.lastDraw;
    let draws = after.drawCount - before.drawCount;
    let coinCost = before.coins - after.coins;
    let ticketCost = coinCost == 0 ? draws : 0;
    let tickets = before.get('tickets', 0);
    return after.diff(before).affectedKeys().hasOnly(
        ['coins', 'characters', 'drawCount', 'lastDraw', 'lastBanner', 'tickets', 'gradeCounts'])
      && after.coins is int && after.coins >= 0
      && picks is list && picks.size() == draws
      && isBannerDraw(after.lastBanner, draws, coinCost, picks)
      && isExactGain(after.characters, before.characters, picks)
      && isGradeGain(after.gradeCounts, before.get('gradeCounts', {}), draws)
      && tickets >= ticketCost
      && after.get('tickets', 0) == tickets - ticketCost;
  }

  function isGradeGain(ag, bg, draws) {
    return ag is map && ag.keys().hasOnly(['N', 'R', 'EP', 'U', 'L', 'E', 'H'])
      && ag.get('N', 0) >= bg.get('N', 0) && ag.get('R', 0) >= bg.get('R', 0) && ag.get('EP', 0) >= bg.get('EP', 0) && ag.get('U', 0) >= bg.get('U', 0) && ag.get('L', 0) >= bg.get('L', 0) && ag.get('E', 0) >= bg.get('E', 0) && ag.get('H', 0) >= bg.get('H', 0)
      && (ag.get('N', 0) - bg.get('N', 0)) + (ag.get('R', 0) - bg.get('R', 0)) + (ag.get('EP', 0) - bg.get('EP', 0)) + (ag.get('U', 0) - bg.get('U', 0)) + (ag.get('L', 0) - bg.get('L', 0)) + (ag.get('E', 0) - bg.get('E', 0)) + (ag.get('H', 0) - bg.get('H', 0)) == draws;
  }

  function price(draws, cost, one, ten) {
    return (draws == 1 && cost == one) || (draws == 10 && cost == ten);
  }

  function pay(draws, cost, one, ten, ticketable) {
    return (ticketable && cost == 0 && (draws == 1 || draws == 10)) || price(draws, cost, one, ten);
  }

  // Each banner draws from the base collection, its own and mixed collections and any hidden in it. The picks
  // are checked as one comma-joined string against one regex literal.
  function isBannerDraw(banner, draws, cost, picks) {
    return exists(/databases/$(database)/documents/gachaCatalog/live)
      ? isPublishedBannerDraw(banner, draws, cost, picks) : ((banner == 'normal' && pay(draws, cost, 5, 45, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$'))
      || (banner == 'autumn' && pay(draws, cost, 8, 72, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|autumn_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|autumn_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$'))
      || (banner == 'sea' && pay(draws, cost, 8, 72, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|sea_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|sea_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$'))
      || (banner == 'cats' && pay(draws, cost, 10, 90, true)
        && picks.join(',').matches('^(?:cats_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_rare_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_epic_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_unique_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_legendary_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_hidden_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora))(?:,(?:cats_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_rare_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_epic_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_unique_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_legendary_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)|cats_hidden_(?:abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)))*$'))
      || (banner == 'premium' && pay(draws, cost, 10, 90, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|premium_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|epic_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|unique_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|legendary_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|premium_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|epic_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|unique_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|legendary_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$')));
  }

  function isPublishedBannerDraw(id, draws, cost, picks) {
    let b = get(/databases/$(database)/documents/gachaBanners/$(id)).data;
    return b.enabled && b.version == get(/databases/$(database)/documents/gachaCatalog/live).data.version
      && pay(draws, cost, b.cost1, b.cost10, b.ticketable)
      && picks.join(',').matches(b.poolRegex);
  }

  // Only picked characters change, and each grows by exactly how many times it was picked.
  function isExactGain(a, b, picks) {
    return a.diff(b).affectedKeys().hasOnly(picks)
      && slot(a, b, picks, 0)
      && slot(a, b, picks, 1)
      && slot(a, b, picks, 2)
      && slot(a, b, picks, 3)
      && slot(a, b, picks, 4)
      && slot(a, b, picks, 5)
      && slot(a, b, picks, 6)
      && slot(a, b, picks, 7)
      && slot(a, b, picks, 8)
      && slot(a, b, picks, 9);
  }

  function slot(a, b, picks, i) {
    return i >= picks.size()
      || a.get(picks[i], 0) - b.get(picks[i], 0) == picks.size() - picks.removeAll([picks[i]]).size();
  }

  // Achievement ids, amounts from assets/gacha/rewards.json; -1 means not earned (or not a real achievement).
  function claimReward(p, u) {
    return p[0] == 'grade_first' && p.size() == 2 ? gradeFirstReward(p[1], u.characters)
      : p[0] == 'grade_count' && p.size() == 3 ? gradeCountReward(p[1], p[2], u.get('gradeCounts', {}))
      : p[0] == 'char_first' && p.size() == 2 ? charFirstReward(p[1], u.characters)
      : p[0] == 'char_count' && p.size() == 3 ? charCountReward(p[1], p[2], u.characters)
      : p[0] == 'collection_complete' && p.size() == 2 ? collectionReward(p[1], u.characters)
      : p[0] == 'draws' && p.size() == 2 ? drawsReward(p[1], u.drawCount)
      : -1;
  }

  function gradeFirstReward(g, chars) {
    return g == 'N' ? ((chars.keys().hasAny(['mouse', 'cow', 'tiger', 'rabbit', 'dragon', 'snake', 'horse', 'sheep', 'monkey', 'chicken', 'dog', 'pig', 'cats_abyssinian', 'cats_american_shorthair', 'cats_bengal', 'cats_british_shorthair', 'cats_maine_coon', 'cats_persian', 'cats_ragdoll', 'cats_russian_blue', 'cats_siamese', 'cats_turkish_angora', 'baby_mouse', 'baby_cow', 'baby_tiger', 'baby_rabbit', 'baby_dragon', 'baby_snake', 'baby_horse', 'baby_sheep', 'baby_monkey', 'baby_chicken', 'baby_dog', 'baby_pig', 'baby_abyssinian', 'baby_american_shorthair', 'baby_bengal', 'baby_british_shorthair', 'baby_maine_coon', 'baby_persian', 'baby_ragdoll', 'baby_russian_blue', 'baby_siamese', 'baby_turkish_angora']) || publishedGradeOwned(g, chars)) ? 10 : -1)
      : g == 'R' ? ((chars.keys().hasAny(['sea_mouse', 'sea_cow', 'sea_tiger', 'sea_rabbit', 'sea_dragon', 'sea_snake', 'sea_horse', 'sea_sheep', 'sea_monkey', 'sea_chicken', 'sea_dog', 'sea_pig', 'cats_rare_abyssinian', 'cats_rare_american_shorthair', 'cats_rare_bengal', 'cats_rare_british_shorthair', 'cats_rare_maine_coon', 'cats_rare_persian', 'cats_rare_ragdoll', 'cats_rare_russian_blue', 'cats_rare_siamese', 'cats_rare_turkish_angora', 'rare_mouse', 'rare_cow', 'rare_tiger', 'rare_rabbit', 'rare_dragon', 'rare_snake', 'rare_horse', 'rare_sheep', 'rare_monkey', 'rare_chicken', 'rare_dog', 'rare_pig', 'premium_mouse', 'premium_cow', 'premium_tiger', 'premium_rabbit', 'premium_dragon', 'premium_snake', 'premium_horse', 'premium_sheep', 'premium_monkey', 'premium_chicken', 'premium_dog', 'premium_pig']) || publishedGradeOwned(g, chars)) ? 10 : -1)
      : g == 'EP' ? ((chars.keys().hasAny(['cats_epic_abyssinian', 'cats_epic_american_shorthair', 'cats_epic_bengal', 'cats_epic_british_shorthair', 'cats_epic_maine_coon', 'cats_epic_persian', 'cats_epic_ragdoll', 'cats_epic_russian_blue', 'cats_epic_siamese', 'cats_epic_turkish_angora', 'epic_mouse', 'epic_cow', 'epic_tiger', 'epic_rabbit', 'epic_dragon', 'epic_snake', 'epic_horse', 'epic_sheep', 'epic_monkey', 'epic_chicken', 'epic_dog', 'epic_pig']) || publishedGradeOwned(g, chars)) ? 20 : -1)
      : g == 'U' ? ((chars.keys().hasAny(['cats_unique_abyssinian', 'cats_unique_american_shorthair', 'cats_unique_bengal', 'cats_unique_british_shorthair', 'cats_unique_maine_coon', 'cats_unique_persian', 'cats_unique_ragdoll', 'cats_unique_russian_blue', 'cats_unique_siamese', 'cats_unique_turkish_angora', 'unique_mouse', 'unique_cow', 'unique_tiger', 'unique_rabbit', 'unique_dragon', 'unique_snake', 'unique_horse', 'unique_sheep', 'unique_monkey', 'unique_chicken', 'unique_dog', 'unique_pig']) || publishedGradeOwned(g, chars)) ? 30 : -1)
      : g == 'L' ? ((chars.keys().hasAny(['cats_legendary_abyssinian', 'cats_legendary_american_shorthair', 'cats_legendary_bengal', 'cats_legendary_british_shorthair', 'cats_legendary_maine_coon', 'cats_legendary_persian', 'cats_legendary_ragdoll', 'cats_legendary_russian_blue', 'cats_legendary_siamese', 'cats_legendary_turkish_angora', 'legendary_mouse', 'legendary_cow', 'legendary_tiger', 'legendary_rabbit', 'legendary_dragon', 'legendary_snake', 'legendary_horse', 'legendary_sheep', 'legendary_monkey', 'legendary_chicken', 'legendary_dog', 'legendary_pig']) || publishedGradeOwned(g, chars)) ? 50 : -1)
      : g == 'E' ? ((chars.keys().hasAny(['autumn_mouse', 'autumn_cow', 'autumn_tiger', 'autumn_rabbit', 'autumn_dragon', 'autumn_snake', 'autumn_horse', 'autumn_sheep', 'autumn_monkey', 'autumn_chicken', 'autumn_dog', 'autumn_pig']) || publishedGradeOwned(g, chars)) ? 10 : -1)
      : g == 'H' ? ((chars.keys().hasAny(['cats_hidden_abyssinian', 'cats_hidden_american_shorthair', 'cats_hidden_bengal', 'cats_hidden_british_shorthair', 'cats_hidden_maine_coon', 'cats_hidden_persian', 'cats_hidden_ragdoll', 'cats_hidden_russian_blue', 'cats_hidden_siamese', 'cats_hidden_turkish_angora', 'hidden_mouse', 'hidden_cow', 'hidden_tiger', 'hidden_rabbit', 'hidden_dragon', 'hidden_snake', 'hidden_horse', 'hidden_sheep', 'hidden_monkey', 'hidden_chicken', 'hidden_dog', 'hidden_pig']) || publishedGradeOwned(g, chars)) ? 30 : -1)
      : -1;
  }

  // Numbers must be written canonically ("5", not "05") so one milestone can't be claimed twice.
  function publishedGradeOwned(g, chars) {
    return exists(/databases/$(database)/documents/gachaCatalog/live)
      && chars.keys().hasAny(get(/databases/$(database)/documents/gachaCatalog/live).data.gradeIds.get(g, []))
      && !chars.values().hasAny([0]);
  }

  function gradeCountReward(g, s, counts) {
    let m = int(s);
    return string(m) == s && m > 0 && m % 100 == 0 && counts.get(g, 0) >= m
      ? g == 'N' ? 10
        : g == 'R' ? 10
        : g == 'EP' ? 10
        : g == 'U' ? 10
        : g == 'L' ? 10
        : g == 'E' ? 10
        : g == 'H' ? 10
        : -1
      : -1;
  }

  function charFirstReward(c, chars) {
    return (c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^autumn_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_rare_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_epic_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_unique_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_legendary_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_hidden_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig|abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') || exists(/databases/$(database)/documents/gachaCharacters/$(c))) && chars.get(c, 0) > 0
      ? gradeOf(c) == 'EP' ? 10
        : gradeOf(c) == 'U' ? 15
        : gradeOf(c) == 'L' ? 30
        : gradeOf(c) == 'H' ? 30
        : 5
      : -1;
  }

  function charCountReward(c, s, chars) {
    let m = int(s);
    return string(m) == s && (c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^autumn_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^cats_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_rare_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_epic_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_unique_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_legendary_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^cats_hidden_(abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig|abyssinian|american_shorthair|bengal|british_shorthair|maine_coon|persian|ragdoll|russian_blue|siamese|turkish_angora)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') || exists(/databases/$(database)/documents/gachaCharacters/$(c))) && chars.get(c, 0) >= m
      ? ([5, 10, 30, 50].hasAny([m]) ? gradeOf(c) == 'U' ? 10
        : gradeOf(c) == 'L' ? 10
        : gradeOf(c) == 'H' ? 10
        : 5
        : m > 0 && m % 100 == 0 ? gradeOf(c) == 'L' ? 20
        : gradeOf(c) == 'H' ? 20
        : 10
        : -1)
      : -1;
  }

  function collectionReward(col, chars) {
    return exists(/databases/$(database)/documents/gachaCollections/$(col))
      ? (chars.keys().hasAll(get(/databases/$(database)/documents/gachaCollections/$(col)).data.characterIds) && !chars.values().hasAny([0]) ? 30 : -1)
      : col == 'normal' ? (chars.keys().hasAll(['mouse', 'cow', 'tiger', 'rabbit', 'dragon', 'snake', 'horse', 'sheep', 'monkey', 'chicken', 'dog', 'pig']) ? 30 : -1)
      : col == 'autumn' ? (chars.keys().hasAll(['autumn_mouse', 'autumn_cow', 'autumn_tiger', 'autumn_rabbit', 'autumn_dragon', 'autumn_snake', 'autumn_horse', 'autumn_sheep', 'autumn_monkey', 'autumn_chicken', 'autumn_dog', 'autumn_pig']) ? 30 : -1)
      : col == 'sea' ? (chars.keys().hasAll(['sea_mouse', 'sea_cow', 'sea_tiger', 'sea_rabbit', 'sea_dragon', 'sea_snake', 'sea_horse', 'sea_sheep', 'sea_monkey', 'sea_chicken', 'sea_dog', 'sea_pig']) ? 30 : -1)
      : col == 'cats' ? (chars.keys().hasAll(['cats_abyssinian', 'cats_american_shorthair', 'cats_bengal', 'cats_british_shorthair', 'cats_maine_coon', 'cats_persian', 'cats_ragdoll', 'cats_russian_blue', 'cats_siamese', 'cats_turkish_angora']) ? 30 : -1)
      : col == 'cats_rare' ? (chars.keys().hasAll(['cats_rare_abyssinian', 'cats_rare_american_shorthair', 'cats_rare_bengal', 'cats_rare_british_shorthair', 'cats_rare_maine_coon', 'cats_rare_persian', 'cats_rare_ragdoll', 'cats_rare_russian_blue', 'cats_rare_siamese', 'cats_rare_turkish_angora']) ? 30 : -1)
      : col == 'cats_epic' ? (chars.keys().hasAll(['cats_epic_abyssinian', 'cats_epic_american_shorthair', 'cats_epic_bengal', 'cats_epic_british_shorthair', 'cats_epic_maine_coon', 'cats_epic_persian', 'cats_epic_ragdoll', 'cats_epic_russian_blue', 'cats_epic_siamese', 'cats_epic_turkish_angora']) ? 30 : -1)
      : col == 'cats_unique' ? (chars.keys().hasAll(['cats_unique_abyssinian', 'cats_unique_american_shorthair', 'cats_unique_bengal', 'cats_unique_british_shorthair', 'cats_unique_maine_coon', 'cats_unique_persian', 'cats_unique_ragdoll', 'cats_unique_russian_blue', 'cats_unique_siamese', 'cats_unique_turkish_angora']) ? 30 : -1)
      : col == 'cats_legendary' ? (chars.keys().hasAll(['cats_legendary_abyssinian', 'cats_legendary_american_shorthair', 'cats_legendary_bengal', 'cats_legendary_british_shorthair', 'cats_legendary_maine_coon', 'cats_legendary_persian', 'cats_legendary_ragdoll', 'cats_legendary_russian_blue', 'cats_legendary_siamese', 'cats_legendary_turkish_angora']) ? 30 : -1)
      : col == 'cats_hidden' ? (chars.keys().hasAll(['cats_hidden_abyssinian', 'cats_hidden_american_shorthair', 'cats_hidden_bengal', 'cats_hidden_british_shorthair', 'cats_hidden_maine_coon', 'cats_hidden_persian', 'cats_hidden_ragdoll', 'cats_hidden_russian_blue', 'cats_hidden_siamese', 'cats_hidden_turkish_angora']) ? 30 : -1)
      : col == 'rare' ? (chars.keys().hasAll(['rare_mouse', 'rare_cow', 'rare_tiger', 'rare_rabbit', 'rare_dragon', 'rare_snake', 'rare_horse', 'rare_sheep', 'rare_monkey', 'rare_chicken', 'rare_dog', 'rare_pig']) ? 30 : -1)
      : col == 'premium' ? (chars.keys().hasAll(['premium_mouse', 'premium_cow', 'premium_tiger', 'premium_rabbit', 'premium_dragon', 'premium_snake', 'premium_horse', 'premium_sheep', 'premium_monkey', 'premium_chicken', 'premium_dog', 'premium_pig']) ? 30 : -1)
      : col == 'baby' ? (chars.keys().hasAll(['baby_mouse', 'baby_cow', 'baby_tiger', 'baby_rabbit', 'baby_dragon', 'baby_snake', 'baby_horse', 'baby_sheep', 'baby_monkey', 'baby_chicken', 'baby_dog', 'baby_pig', 'baby_abyssinian', 'baby_american_shorthair', 'baby_bengal', 'baby_british_shorthair', 'baby_maine_coon', 'baby_persian', 'baby_ragdoll', 'baby_russian_blue', 'baby_siamese', 'baby_turkish_angora']) ? 30 : -1)
      : col == 'epic' ? (chars.keys().hasAll(['epic_mouse', 'epic_cow', 'epic_tiger', 'epic_rabbit', 'epic_dragon', 'epic_snake', 'epic_horse', 'epic_sheep', 'epic_monkey', 'epic_chicken', 'epic_dog', 'epic_pig']) ? 30 : -1)
      : col == 'unique' ? (chars.keys().hasAll(['unique_mouse', 'unique_cow', 'unique_tiger', 'unique_rabbit', 'unique_dragon', 'unique_snake', 'unique_horse', 'unique_sheep', 'unique_monkey', 'unique_chicken', 'unique_dog', 'unique_pig']) ? 30 : -1)
      : col == 'legendary' ? (chars.keys().hasAll(['legendary_mouse', 'legendary_cow', 'legendary_tiger', 'legendary_rabbit', 'legendary_dragon', 'legendary_snake', 'legendary_horse', 'legendary_sheep', 'legendary_monkey', 'legendary_chicken', 'legendary_dog', 'legendary_pig']) ? 30 : -1)
      : col == 'hidden' ? (chars.keys().hasAll(['hidden_mouse', 'hidden_cow', 'hidden_tiger', 'hidden_rabbit', 'hidden_dragon', 'hidden_snake', 'hidden_horse', 'hidden_sheep', 'hidden_monkey', 'hidden_chicken', 'hidden_dog', 'hidden_pig']) ? 30 : -1)
      : -1;
  }

  function drawsReward(s, n) {
    let m = int(s);
    return string(m) == s && n >= m
      && ([100, 500].hasAny([m]) || (m > 0 && m % 1000 == 0))
      ? 20
      : -1;
  }
  }
}
