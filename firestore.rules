rules_version = '2';

// Generated by scripts/generate-gacha.js from assets/gacha. Do not edit by hand.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isNewProfile();
      allow update: if isOwner(uid)
        && (isLegalDraw() || isClaim(uid) || isStepReward() || isAvatarChange() || isHatch(uid) || isUsernameChange()
          || isNicknameChange() || isFuse() || isRecycle() || isEvolve(uid));
      // Leaving: the profile goes first, then its history (see isGone).
      allow delete: if isOwner(uid);
    }

    // The breeding nest: at most three eggs, one per slot. An egg only goes away by hatching.
    match /users/{uid}/eggs/{slot} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && slot in ['0', '1', '2'] && isEgg(uid);
      allow delete: if isOwner(uid)
        && (getAfter(/databases/$(database)/documents/users/$(uid)).data.get('lastHatch', '') == slot || isGone(uid));
    }

    // Steps walked with each character as the map avatar; evolving spends them.
    match /companions/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && (isCompanionSteps(uid) || isEvolveSpend(uid));
      allow delete: if isOwner(uid);
    }

    // Crafting writes lastCraft { inputs, output } with its counter. Odds are rolled on the phone, so these
    // only check that the outcome is possible.

    // Fusion: any two characters of one grade plus that grade's coins become a pool animal one tier up, or
    // nothing on failure.
    function isFuse() {
      let before = resource.data;
      let after = request.resource.data;
      let craft = after.lastCraft;
      let c = craft.inputs[0];
      let d = craft.inputs[1];
      let a = after.characters;
      let b = before.characters;
      let fee = fusionCoins(gradeOf(c));
      return after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'fuseCount', 'lastCraft'])
        && after.get('fuseCount', 0) == before.get('fuseCount', 0) + 1
        && craft.keys().hasOnly(['inputs', 'output']) && craft.inputs == [c, d]
        && gradeOf(c) == gradeOf(d)
        && fee >= 0 && before.coins - after.coins == fee && after.coins >= 0
        && (c == d
          ? a.get(c, 0) == b.get(c, 0) - 2
          : a.get(c, 0) == b.get(c, 0) - 1 && a.get(d, 0) == b.get(d, 0) - 1)
        && a.get(c, 0) >= 0 && a.get(d, 0) >= 0
        && (craft.output == null
          ? a.diff(b).affectedKeys().hasOnly([c, d])
          : poolTier(craft.output) == tierOf(c) + 1
            && a.diff(b).affectedKeys().hasOnly([c, d, craft.output])
            && a.get(craft.output, 0) == b.get(craft.output, 0) + 1);
    }

    // Recycling: 10 characters from the crafting tiers become one pool animal of any tier (higher tiers
    // are rarer the further they are above the lowest input, down to tiny chances).
    function isRecycle() {
      let before = resource.data;
      let after = request.resource.data;
      let inputs = after.lastCraft.inputs;
      let out = after.lastCraft.output;
      let a = after.characters;
      let b = before.characters;
      let t = poolTier(out);
      let allowed = '^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$';
      return after.diff(before).affectedKeys().hasOnly(['characters', 'recycleCount', 'lastCraft'])
        && after.get('recycleCount', 0) == before.get('recycleCount', 0) + 1
        && after.lastCraft.keys().hasOnly(['inputs', 'output'])
        && inputs is list && inputs.size() == 10 && out is string && t > 0
        && a.diff(b).affectedKeys().hasOnly(inputs.concat([out]))
        && a.get(out, 0) - b.get(out, 0) == 1 - (10 - inputs.removeAll([out]).size())
        && recycled(a, b, inputs, out, allowed, 0)
        && recycled(a, b, inputs, out, allowed, 1)
        && recycled(a, b, inputs, out, allowed, 2)
        && recycled(a, b, inputs, out, allowed, 3)
        && recycled(a, b, inputs, out, allowed, 4)
        && recycled(a, b, inputs, out, allowed, 5)
        && recycled(a, b, inputs, out, allowed, 6)
        && recycled(a, b, inputs, out, allowed, 7)
        && recycled(a, b, inputs, out, allowed, 8)
        && recycled(a, b, inputs, out, allowed, 9);
    }

    function recycled(a, b, inputs, out, allowed, i) {
      let c = inputs[i];
      return c.matches(allowed) && a.get(c, 0) >= 0
        && (c == out || a.get(c, 0) - b.get(c, 0) == inputs.removeAll([c]).size() - 10);
    }

    // Evolution: one character becomes the same animal in the next collection, paid with coins and the
    // steps walked with it (spent from companions in the same write). The avatar may follow it.
    function isEvolve(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let c = after.lastCraft.inputs[0];
      let out = evolveTarget(c);
      let a = after.characters;
      let b = before.characters;
      let need = evolveSteps(gradeOf(c));
      let path = /databases/$(database)/documents/companions/$(uid);
      return after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'evolveCount', 'lastCraft', 'avatar'])
        && after.get('evolveCount', 0) == before.get('evolveCount', 0) + 1
        && after.lastCraft == { 'inputs': [c], 'output': out }
        && out != '' && need > 0
        && before.coins - after.coins == evolveCoins(gradeOf(c)) && after.coins >= 0
        && a.diff(b).affectedKeys().hasOnly([c, out])
        && a.get(c, 0) == b.get(c, 0) - 1 && a.get(c, 0) >= 0
        && a.get(out, 0) == b.get(out, 0) + 1
        && (after.get('avatar', null) == before.get('avatar', null) || after.avatar == out)
        && get(path).data.steps.get(c, 0) >= need
        && getAfter(path).data.steps.get(c, 0) == get(path).data.steps.get(c, 0) - need;
    }

    function isEvolveSpend(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      let c = getAfter(path).data.lastCraft.inputs[0];
      let before = resource.data.steps;
      let after = request.resource.data.steps;
      return getAfter(path).data.get('evolveCount', 0) == get(path).data.get('evolveCount', 0) + 1
        && request.resource.data.keys().hasOnly(['steps'])
        && after.diff(before).affectedKeys().hasOnly([c])
        && after.get(c, 0) == before.get(c, 0) - evolveSteps(gradeOf(c));
    }

    // Public leaderboard entry, a copy of the player's profile numbers; any signed-in player can read it.
    match /rankings/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && isRanking(uid);
      allow delete: if isOwner(uid);
    }

    function isRanking(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let d = request.resource.data;
      let counts = ['hatchCount', 'evolveCount', 'fuseCount', 'recycleCount'];
      let fields = ['username', 'avatar', 'steps', 'characters', 'updatedAt'].concat(counts);
      return d.keys().hasOnly(fields.concat(['nickname'])) && d.keys().hasAll(fields)
        && d.username == user.username
        && d.get('nickname', null) == user.get('nickname', null)
        && d.avatar == user.get('avatar', null)
        && d.steps == user.get('steps', 0)
        && d.characters == user.characters
        && d.hatchCount == user.get('hatchCount', 0)
        && d.evolveCount == user.get('evolveCount', 0)
        && d.fuseCount == user.get('fuseCount', 0)
        && d.recycleCount == user.get('recycleCount', 0)
        && d.updatedAt == request.time;
    }

    // History may only be cleared once its profile is deleted, so claims can't be wiped and claimed again.
    function isGone(uid) {
      return !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    // Laying an egg is free and keeps both parents. Only grades with a hatch time in rewards.json can breed.
    function isEgg(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let egg = request.resource.data;
      let p = egg.parents;
      let fields = ['parents', 'child', 'grade', 'createdAt'];
      return egg.keys().hasOnly(fields) && egg.keys().hasAll(fields)
        && p is list && p.size() == 2 && p[0] is string && p[1] is string
        && user.characters.get(p[0], 0) > 0
        && user.characters.get(p[1], 0) > (p[0] == p[1] ? 1 : 0)
        && hatchMinutes(gradeOf(p[0])) > 0 && hatchMinutes(gradeOf(p[1])) > 0
        && (isBaby(egg.child, p) || isPoolChild(egg.child, p))
        && egg.grade == gradeOf(egg.child)
        && egg.createdAt == request.time;
    }

    // Hatching adds the child and deletes its egg. Before hatchMinutes have passed it costs
    // 1 coin(s) per minute left; one extra minute is allowed for clock drift.
    function isHatch(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let path = /databases/$(database)/documents/users/$(uid)/eggs/$(after.lastHatch);
      let egg = get(path).data;
      let left = (egg.createdAt + duration.value(hatchMinutes(egg.grade), 'm') - request.time).seconds();
      let cost = left > 0 ? math.ceil(left / 60.0) * 1 : 0;
      let paid = before.coins - after.coins;
      return after.diff(before).affectedKeys().hasOnly(['characters', 'coins', 'lastHatch', 'hatchCount'])
        && after.lastHatch in ['0', '1', '2']
        && after.hatchCount == before.get('hatchCount', 0) + 1
        && !existsAfter(path)
        && after.characters.diff(before.characters).affectedKeys().hasOnly([egg.child])
        && after.characters.get(egg.child, 0) == before.characters.get(egg.child, 0) + 1
        && after.coins >= 0
        && paid >= cost && paid <= cost + 1;
    }

    // Only the current avatar's count may grow. Steps come from the phone, so amounts can't be verified.
    function isCompanionSteps(uid) {
      let avatar = get(/databases/$(database)/documents/users/$(uid)).data.get('avatar', null);
      let before = request.method == 'create' ? {} : resource.data.steps;
      let after = request.resource.data;
      return after.keys().hasOnly(['steps'])
        && avatar is string
        && after.steps.diff(before).affectedKeys().hasOnly([avatar])
        && after.steps[avatar] is int && after.steps[avatar] > before.get(avatar, 0);
    }

    // Where each player is on the map; any signed-in player can see everyone who shares.
    match /locations/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && isLocation(uid);
      allow delete: if isOwner(uid);
    }

    // Write-once history: users/{uid}/draws/{drawCount after the draw}, saved alongside each draw.
    match /users/{uid}/draws/{drawId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isDrawLog(uid, drawId);
      allow delete: if isOwner(uid) && isGone(uid);
    }

    // Write-once achievement claims: users/{uid}/claims/{achievement id}, saved alongside the tickets.
    match /users/{uid}/claims/{claimId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isClaimLog(uid, claimId);
      allow delete: if isOwner(uid) && isGone(uid);
    }

    function isDrawLog(uid, drawId) {
      let user = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let log = request.resource.data;
      return drawId == string(user.drawCount)
        && log.keys().hasOnly(['banner', 'picks', 'coins', 'tickets', 'rewards', 'createdAt'])
        && log.banner == user.lastBanner
        && log.picks == user.lastDraw
        && log.createdAt == request.time;
    }

    // Claiming an achievement adds its tickets once; the claim document makes it permanent.
    function isClaim(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let id = after.lastClaim;
      let reward = claimReward(id.split(':'), before);
      return after.diff(before).affectedKeys().hasOnly(['tickets', 'lastClaim'])
        && id is string
        && !exists(/databases/$(database)/documents/users/$(uid)/claims/$(id))
        && existsAfter(/databases/$(database)/documents/users/$(uid)/claims/$(id))
        && reward > 0
        && after.tickets == before.get('tickets', 0) + reward;
    }

    function isClaimLog(uid, claimId) {
      let user = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let log = request.resource.data;
      return user.lastClaim == claimId
        && log.keys().hasOnly(['tickets', 'label', 'createdAt'])
        && log.tickets == user.tickets - get(/databases/$(database)/documents/users/$(uid)).data.get('tickets', 0)
        && log.createdAt == request.time;
    }

    // The name and face shown on the map must match the player's profile.
    function isLocation(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let d = request.resource.data;
      let fields = ['username', 'avatar', 'lat', 'lng', 'updatedAt'];
      return d.keys().hasOnly(fields.concat(['nickname'])) && d.keys().hasAll(fields)
        && d.username == user.username
        && d.get('nickname', null) == user.get('nickname', null)
        && d.avatar == user.get('avatar', null)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.updatedAt == request.time;
    }
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  // First sign-in: exactly 100 coins, username tied to the account's email. With a birthday
  // (YYYY-MM-DD) the player starts with one of their birth year's zodiac animal, otherwise nothing.
  function isNewProfile() {
    let data = request.resource.data;
    let fields = ['username', 'coins', 'characters', 'drawCount', 'createdAt'];
    return data.keys().hasOnly(fields.concat(['birthday', 'nickname'])) && data.keys().hasAll(fields)
      && (!data.keys().hasAny(['nickname']) || isNickname(data.nickname))
      && data.username is string
      && data.username.matches('^[a-z0-9_]{4,20}$')
      && request.auth.token.email == data.username + '@users.animalsrun.local'
      && data.coins == 100
      && (data.keys().hasAny(['birthday']) ? isStarter(data.characters, data.birthday) : data.characters == {})
      && data.drawCount == 0
      && data.createdAt == request.time;
  }

  function isStarter(characters, birthday) {
    return birthday is string
      && birthday.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
      && int(birthday.split('-')[0]) <= request.time.year()
      && characters == zodiacStarter(['mouse', 'cow', 'tiger', 'rabbit', 'dragon', 'snake', 'horse', 'sheep', 'monkey', 'chicken', 'dog', 'pig'][(zodiacYear(birthday.split('-')) - 4) % 12]);
  }

  // Born before that year's Seollal (MMDD per year from 1900) means the previous zodiac year.
  function zodiacYear(ymd) {
    let year = int(ymd[0]);
    let seollal = '0131,0219,0208,0129,0216,0204,0125,0213,0202,0122,0210,0130,0218,0206,0126,0214,0204,0123,0211,0201,0220,0208,0128,0216,0205,0124,0213,0202,0123,0210,0130,0217,0206,0126,0214,0204,0124,0211,0131,0219,0208,0127,0215,0205,0126,0213,0202,0122,0210,0129,0217,0206,0127,0214,0204,0124,0212,0131,0219,0208,0128,0215,0205,0125,0213,0202,0122,0209,0130,0217,0206,0127,0215,0203,0123,0211,0131,0218,0207,0128,0216,0205,0125,0213,0202,0220,0209,0129,0218,0206,0127,0215,0204,0123,0210,0131,0219,0208,0128,0216,0205,0124,0212,0201,0122,0209,0129,0218,0207,0126,0214,0203,0123,0210,0131,0219,0208,0128,0216,0205,0125,0212,0201,0122,0210,0129,0217,0207,0127,0213,0203,0123,0211,0131,0219,0208,0128,0215,0204,0124,0212,0201,0122,0210,0130,0217,0206,0126,0214,0202,0123,0211,0201,0219,0208,0128,0215,0204,0124,0212,0202,0122,0209,0129,0217,0205,0126,0214,0203,0123,0211,0131,0219,0207,0127,0215,0205,0124,0212,0202,0122,0209,0129,0217,0206,0126,0214,0203,0124,0211,0130,0218,0208,0127,0215,0205,0125,0212,0201,0121'.split(',')[year - 1900];
    return int(ymd[1] + ymd[2]) < int(seollal) ? year - 1 : year;
  }

  function zodiacStarter(id) {
    return id == 'mouse' ? { 'mouse': 1 }
      : id == 'cow' ? { 'cow': 1 }
      : id == 'tiger' ? { 'tiger': 1 }
      : id == 'rabbit' ? { 'rabbit': 1 }
      : id == 'dragon' ? { 'dragon': 1 }
      : id == 'snake' ? { 'snake': 1 }
      : id == 'horse' ? { 'horse': 1 }
      : id == 'sheep' ? { 'sheep': 1 }
      : id == 'monkey' ? { 'monkey': 1 }
      : id == 'chicken' ? { 'chicken': 1 }
      : id == 'dog' ? { 'dog': 1 }
      : id == 'pig' ? { 'pig': 1 }
      : {};
  }

  // Walking: steps is the running total of counted steps, and every 50 of them is one coin.
  // Step counts come from the phone, so they can't be verified here.
  function isStepReward() {
    let before = resource.data;
    let after = request.resource.data;
    let steps = before.get('steps', 0);
    return after.diff(before).affectedKeys().hasOnly(['coins', 'steps'])
      && after.steps is int && after.steps > steps
      && after.coins == before.coins
        + math.floor(after.steps / 50) - math.floor(steps / 50);
  }

  // The map avatar is one of the player's own characters, or null for none.
  function isAvatarChange() {
    let after = request.resource.data;
    return after.diff(resource.data).affectedKeys().hasOnly(['avatar'])
      && (after.avatar == null || (after.avatar is string && resource.data.characters.get(after.avatar, 0) > 0));
  }

  // A new id follows the account's email, which Firebase Auth keeps unique.
  function isUsernameChange() {
    let after = request.resource.data;
    return after.diff(resource.data).affectedKeys().hasOnly(['username'])
      && after.username is string
      && after.username.matches('^[a-z0-9_]{4,20}$')
      && request.auth.token.email == after.username + '@users.animalsrun.local';
  }

  // The name shown to other players; unlike the id it needn't be unique.
  function isNicknameChange() {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
      && isNickname(request.resource.data.nickname);
  }

  function isNickname(n) {
    return n is string && n.matches('^[가-힣a-zA-Z0-9_]{2,10}$');
  }

  function gradeOf(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'N'
      : c.matches('^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'R'
      : c.matches('^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'EP'
      : c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'U'
      : c.matches('^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'L'
      : c.matches('^autumn_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'E'
      : c.matches('^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'H'
      : '';
  }

  function hatchMinutes(g) {
    return g == 'N' ? 60
      : g == 'R' ? 720
      : g == 'EP' ? 1440
      : g == 'U' ? 2880
      : g == 'L' ? 4320
      : -1;
  }

  // Crafting tier (position in rewards.json crafting.tiers, from 1) of any character, or 0 outside the tiers.
  function tierOf(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 1
      : c.matches('^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 2
      : c.matches('^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 3
      : c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 4
      : c.matches('^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 5
      : 0;
  }

  // The same, for animals crafting can produce (crafting.pool).
  function poolTier(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 1
      : c.matches('^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 2
      : c.matches('^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 3
      : c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 4
      : c.matches('^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 5
      : 0;
  }

  // The animal behind an id, e.g. 'tiger' for 'sea_tiger'.
  function speciesOf(c) {
    return c.replace('^(autumn|sea|rare|premium|baby|epic|unique|legendary|hidden)_', '');
  }

  // 10% of eggs hold the baby version of a parent's animal.
  function isBaby(child, p) {
    return child.matches('^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$')
      && (child == 'baby_' + speciesOf(p[0]) || child == 'baby_' + speciesOf(p[1]));
  }

  // Otherwise a pool animal no higher than one of the parents (picked at random on the phone).
  function isPoolChild(child, p) {
    let t = poolTier(child);
    return t > 0 && (t <= tierOf(p[0]) || t <= tierOf(p[1]));
  }

  function evolveTarget(c) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'rare_' + speciesOf(c)
      : c.matches('^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'epic_' + speciesOf(c)
      : c.matches('^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'unique_' + speciesOf(c)
      : c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 'legendary_' + speciesOf(c)
      : '';
  }

  function evolveSteps(g) {
    return g == 'N' ? 3000
      : g == 'R' ? 6000
      : g == 'EP' ? 12000
      : g == 'U' ? 24000
      : -1;
  }

  function evolveCoins(g) {
    return g == 'N' ? 10
      : g == 'R' ? 30
      : g == 'EP' ? 60
      : g == 'U' ? 120
      : -1;
  }

  function fusionCoins(g) {
    return g == 'N' ? 50
      : g == 'R' ? 80
      : g == 'EP' ? 200
      : g == 'U' ? 400
      : -1;
  }

  // Every draw also writes lastDraw (the ids drawn, in order) and lastBanner. Rules cap evaluation at
  // 1000 expressions per request (a list literal costs one per element), so checks walk the at most 10 picks.
  // A draw paid with 0 coins spends one free ticket per pick instead (only on banners costing at most
  // 10 coins per draw).
  // gradeCounts (characters drawn per grade) only has to grow by the number of picks in total: checking each
  // pick's grade doesn't fit the budget, and every grade pays the same per-100 reward, so shifting counts
  // between grades gains almost nothing.
  function isLegalDraw() {
    let before = resource.data;
    let after = request.resource.data;
    let picks = after.lastDraw;
    let draws = after.drawCount - before.drawCount;
    let coinCost = before.coins - after.coins;
    let ticketCost = coinCost == 0 ? draws : 0;
    let tickets = before.get('tickets', 0);
    return after.diff(before).affectedKeys().hasOnly(
        ['coins', 'characters', 'drawCount', 'lastDraw', 'lastBanner', 'tickets', 'gradeCounts'])
      && after.coins is int && after.coins >= 0
      && picks is list && picks.size() == draws
      && isBannerDraw(after.lastBanner, draws, coinCost, picks)
      && isExactGain(after.characters, before.characters, picks)
      && isGradeGain(after.gradeCounts, before.get('gradeCounts', {}), draws)
      && tickets >= ticketCost
      && after.get('tickets', 0) == tickets - ticketCost;
  }

  function isGradeGain(ag, bg, draws) {
    return ag is map && ag.keys().hasOnly(['N', 'R', 'EP', 'U', 'L', 'E', 'H'])
      && ag.get('N', 0) >= bg.get('N', 0) && ag.get('R', 0) >= bg.get('R', 0) && ag.get('EP', 0) >= bg.get('EP', 0) && ag.get('U', 0) >= bg.get('U', 0) && ag.get('L', 0) >= bg.get('L', 0) && ag.get('E', 0) >= bg.get('E', 0) && ag.get('H', 0) >= bg.get('H', 0)
      && (ag.get('N', 0) - bg.get('N', 0)) + (ag.get('R', 0) - bg.get('R', 0)) + (ag.get('EP', 0) - bg.get('EP', 0)) + (ag.get('U', 0) - bg.get('U', 0)) + (ag.get('L', 0) - bg.get('L', 0)) + (ag.get('E', 0) - bg.get('E', 0)) + (ag.get('H', 0) - bg.get('H', 0)) == draws;
  }

  function price(draws, cost, one, ten) {
    return (draws == 1 && cost == one) || (draws == 10 && cost == ten);
  }

  function pay(draws, cost, one, ten, ticketable) {
    return (ticketable && cost == 0 && (draws == 1 || draws == 10)) || price(draws, cost, one, ten);
  }

  // Each banner draws from the base collection, its own and mixed collections and any hidden in it. The picks
  // are checked as one comma-joined string against one regex literal.
  function isBannerDraw(banner, draws, cost, picks) {
    return (banner == 'normal' && pay(draws, cost, 5, 45, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$'))
      || (banner == 'autumn' && pay(draws, cost, 8, 72, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|autumn_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|autumn_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$'))
      || (banner == 'sea' && pay(draws, cost, 8, 72, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|sea_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|sea_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$'))
      || (banner == 'premium' && pay(draws, cost, 10, 90, true)
        && picks.join(',').matches('^(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|premium_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|epic_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|unique_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|legendary_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig))(?:,(?:(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|premium_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|rare_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|epic_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|unique_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|legendary_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)|hidden_(?:mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)))*$'));
  }

  // Only picked characters change, and each grows by exactly how many times it was picked.
  function isExactGain(a, b, picks) {
    return a.diff(b).affectedKeys().hasOnly(picks)
      && slot(a, b, picks, 0)
      && slot(a, b, picks, 1)
      && slot(a, b, picks, 2)
      && slot(a, b, picks, 3)
      && slot(a, b, picks, 4)
      && slot(a, b, picks, 5)
      && slot(a, b, picks, 6)
      && slot(a, b, picks, 7)
      && slot(a, b, picks, 8)
      && slot(a, b, picks, 9);
  }

  function slot(a, b, picks, i) {
    return i >= picks.size()
      || a.get(picks[i], 0) - b.get(picks[i], 0) == picks.size() - picks.removeAll([picks[i]]).size();
  }

  // Achievement ids, amounts from assets/gacha/rewards.json; -1 means not earned (or not a real achievement).
  function claimReward(p, u) {
    return p[0] == 'grade_first' && p.size() == 2 ? gradeFirstReward(p[1], u.characters)
      : p[0] == 'grade_count' && p.size() == 3 ? gradeCountReward(p[1], p[2], u.get('gradeCounts', {}))
      : p[0] == 'char_first' && p.size() == 2 ? charFirstReward(p[1], u.characters)
      : p[0] == 'char_count' && p.size() == 3 ? charCountReward(p[1], p[2], u.characters)
      : p[0] == 'collection_complete' && p.size() == 2 ? collectionReward(p[1], u.characters)
      : p[0] == 'draws' && p.size() == 2 ? drawsReward(p[1], u.drawCount)
      : -1;
  }

  function gradeFirstReward(g, chars) {
    return g == 'N' ? (chars.keys().hasAny(['mouse', 'cow', 'tiger', 'rabbit', 'dragon', 'snake', 'horse', 'sheep', 'monkey', 'chicken', 'dog', 'pig', 'baby_mouse', 'baby_cow', 'baby_tiger', 'baby_rabbit', 'baby_dragon', 'baby_snake', 'baby_horse', 'baby_sheep', 'baby_monkey', 'baby_chicken', 'baby_dog', 'baby_pig']) ? 10 : -1)
      : g == 'R' ? (chars.keys().hasAny(['sea_mouse', 'sea_cow', 'sea_tiger', 'sea_rabbit', 'sea_dragon', 'sea_snake', 'sea_horse', 'sea_sheep', 'sea_monkey', 'sea_chicken', 'sea_dog', 'sea_pig', 'rare_mouse', 'rare_cow', 'rare_tiger', 'rare_rabbit', 'rare_dragon', 'rare_snake', 'rare_horse', 'rare_sheep', 'rare_monkey', 'rare_chicken', 'rare_dog', 'rare_pig', 'premium_mouse', 'premium_cow', 'premium_tiger', 'premium_rabbit', 'premium_dragon', 'premium_snake', 'premium_horse', 'premium_sheep', 'premium_monkey', 'premium_chicken', 'premium_dog', 'premium_pig']) ? 10 : -1)
      : g == 'EP' ? (chars.keys().hasAny(['epic_mouse', 'epic_cow', 'epic_tiger', 'epic_rabbit', 'epic_dragon', 'epic_snake', 'epic_horse', 'epic_sheep', 'epic_monkey', 'epic_chicken', 'epic_dog', 'epic_pig']) ? 20 : -1)
      : g == 'U' ? (chars.keys().hasAny(['unique_mouse', 'unique_cow', 'unique_tiger', 'unique_rabbit', 'unique_dragon', 'unique_snake', 'unique_horse', 'unique_sheep', 'unique_monkey', 'unique_chicken', 'unique_dog', 'unique_pig']) ? 30 : -1)
      : g == 'L' ? (chars.keys().hasAny(['legendary_mouse', 'legendary_cow', 'legendary_tiger', 'legendary_rabbit', 'legendary_dragon', 'legendary_snake', 'legendary_horse', 'legendary_sheep', 'legendary_monkey', 'legendary_chicken', 'legendary_dog', 'legendary_pig']) ? 50 : -1)
      : g == 'E' ? (chars.keys().hasAny(['autumn_mouse', 'autumn_cow', 'autumn_tiger', 'autumn_rabbit', 'autumn_dragon', 'autumn_snake', 'autumn_horse', 'autumn_sheep', 'autumn_monkey', 'autumn_chicken', 'autumn_dog', 'autumn_pig']) ? 10 : -1)
      : g == 'H' ? (chars.keys().hasAny(['hidden_mouse', 'hidden_cow', 'hidden_tiger', 'hidden_rabbit', 'hidden_dragon', 'hidden_snake', 'hidden_horse', 'hidden_sheep', 'hidden_monkey', 'hidden_chicken', 'hidden_dog', 'hidden_pig']) ? 30 : -1)
      : -1;
  }

  // Numbers must be written canonically ("5", not "05") so one milestone can't be claimed twice.
  function gradeCountReward(g, s, counts) {
    let m = int(s);
    return string(m) == s && m > 0 && m % 100 == 0 && counts.get(g, 0) >= m
      ? g == 'N' ? 10
        : g == 'R' ? 10
        : g == 'EP' ? 10
        : g == 'U' ? 10
        : g == 'L' ? 10
        : g == 'E' ? 10
        : g == 'H' ? 10
        : -1
      : -1;
  }

  function charFirstReward(c, chars) {
    return c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^autumn_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') && chars.get(c, 0) > 0
      ? c.matches('^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 10
        : c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 15
        : c.matches('^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 30
        : c.matches('^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 30
        : 5
      : -1;
  }

  function charCountReward(c, s, chars) {
    let m = int(s);
    return string(m) == s && c.matches('^(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^autumn_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^sea_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^rare_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^premium_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^baby_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^epic_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$|^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') && chars.get(c, 0) >= m
      ? ([5, 10, 30, 50].hasAny([m]) ? c.matches('^unique_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 10
        : c.matches('^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 10
        : c.matches('^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 10
        : 5
        : m > 0 && m % 100 == 0 ? c.matches('^legendary_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 20
        : c.matches('^hidden_(mouse|cow|tiger|rabbit|dragon|snake|horse|sheep|monkey|chicken|dog|pig)$') ? 20
        : 10
        : -1)
      : -1;
  }

  function collectionReward(col, chars) {
    return col == 'normal' ? (chars.keys().hasAll(['mouse', 'cow', 'tiger', 'rabbit', 'dragon', 'snake', 'horse', 'sheep', 'monkey', 'chicken', 'dog', 'pig']) ? 30 : -1)
      : col == 'autumn' ? (chars.keys().hasAll(['autumn_mouse', 'autumn_cow', 'autumn_tiger', 'autumn_rabbit', 'autumn_dragon', 'autumn_snake', 'autumn_horse', 'autumn_sheep', 'autumn_monkey', 'autumn_chicken', 'autumn_dog', 'autumn_pig']) ? 30 : -1)
      : col == 'sea' ? (chars.keys().hasAll(['sea_mouse', 'sea_cow', 'sea_tiger', 'sea_rabbit', 'sea_dragon', 'sea_snake', 'sea_horse', 'sea_sheep', 'sea_monkey', 'sea_chicken', 'sea_dog', 'sea_pig']) ? 30 : -1)
      : col == 'rare' ? (chars.keys().hasAll(['rare_mouse', 'rare_cow', 'rare_tiger', 'rare_rabbit', 'rare_dragon', 'rare_snake', 'rare_horse', 'rare_sheep', 'rare_monkey', 'rare_chicken', 'rare_dog', 'rare_pig']) ? 30 : -1)
      : col == 'premium' ? (chars.keys().hasAll(['premium_mouse', 'premium_cow', 'premium_tiger', 'premium_rabbit', 'premium_dragon', 'premium_snake', 'premium_horse', 'premium_sheep', 'premium_monkey', 'premium_chicken', 'premium_dog', 'premium_pig']) ? 30 : -1)
      : col == 'baby' ? (chars.keys().hasAll(['baby_mouse', 'baby_cow', 'baby_tiger', 'baby_rabbit', 'baby_dragon', 'baby_snake', 'baby_horse', 'baby_sheep', 'baby_monkey', 'baby_chicken', 'baby_dog', 'baby_pig']) ? 30 : -1)
      : col == 'epic' ? (chars.keys().hasAll(['epic_mouse', 'epic_cow', 'epic_tiger', 'epic_rabbit', 'epic_dragon', 'epic_snake', 'epic_horse', 'epic_sheep', 'epic_monkey', 'epic_chicken', 'epic_dog', 'epic_pig']) ? 30 : -1)
      : col == 'unique' ? (chars.keys().hasAll(['unique_mouse', 'unique_cow', 'unique_tiger', 'unique_rabbit', 'unique_dragon', 'unique_snake', 'unique_horse', 'unique_sheep', 'unique_monkey', 'unique_chicken', 'unique_dog', 'unique_pig']) ? 30 : -1)
      : col == 'legendary' ? (chars.keys().hasAll(['legendary_mouse', 'legendary_cow', 'legendary_tiger', 'legendary_rabbit', 'legendary_dragon', 'legendary_snake', 'legendary_horse', 'legendary_sheep', 'legendary_monkey', 'legendary_chicken', 'legendary_dog', 'legendary_pig']) ? 30 : -1)
      : col == 'hidden' ? (chars.keys().hasAll(['hidden_mouse', 'hidden_cow', 'hidden_tiger', 'hidden_rabbit', 'hidden_dragon', 'hidden_snake', 'hidden_horse', 'hidden_sheep', 'hidden_monkey', 'hidden_chicken', 'hidden_dog', 'hidden_pig']) ? 30 : -1)
      : -1;
  }

  function drawsReward(s, n) {
    let m = int(s);
    return string(m) == s && n >= m
      && ([100, 500].hasAny([m]) || (m > 0 && m % 1000 == 0))
      ? 20
      : -1;
  }
}
