rules_version = '2';

// Generated by scripts/generate-gacha.js from assets/gacha. Do not edit by hand.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && exists(/databases/$(database)/documents/activeSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/activeSessions/$(request.auth.uid)).data.active
        && get(/databases/$(database)/documents/activeSessions/$(request.auth.uid)).data.authTime == request.auth.token.auth_time;
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    match /activeSessions/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validSession() {
        let d = request.resource.data;
        return d.keys().hasAll(['sessionId', 'authTime', 'active', 'updatedAt'])
          && d.keys().hasOnly(['sessionId', 'authTime', 'active', 'updatedAt'])
          && d.sessionId is string && d.sessionId.matches('^[A-Za-z0-9_-]{20,128}$')
          && d.authTime is int && d.authTime == request.auth.token.auth_time
          && d.active is bool && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && validSession() && request.resource.data.active;
      allow update: if owner() && validSession() && (
        (request.resource.data.authTime > resource.data.authTime && request.resource.data.active)
        || (request.resource.data.authTime == resource.data.authTime
          && request.resource.data.sessionId == resource.data.sessionId && resource.data.active)
      );
      allow delete: if owner() && request.auth.token.auth_time == resource.data.authTime
        && !exists(/databases/$(database)/documents/users/$(uid));
    }
    function isCommunityAuthor(d) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return d.uid == request.auth.uid && d.name == user.get('nickname', user.username) && d.avatar == user.get('avatar', null);
    }
    function ownsCommunityAnimal(id) {
      return id is string && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.characters.get(id, 0) > 0;
    }
    function validCommunityAnimals(d) {
      let ids = d.get('characters', []);
      return (d.character == null || ownsCommunityAnimal(d.character)) && ids is list && ids.size() <= 3 && ids.toSet().size() == ids.size()
        && (ids.size() < 1 || ownsCommunityAnimal(ids[0])) && (ids.size() < 2 || ownsCommunityAnimal(ids[1])) && (ids.size() < 3 || ownsCommunityAnimal(ids[2]))
        && (!('characters' in d) || (ids.size() == 0 ? d.character == null : d.character == ids[0]))
        && (!('characters' in d) || (d.topic == '자랑' ? ids.size() > 0 : d.topic == '산책' ? ids.size() <= 1 : ids.size() == 0));
    }
    function validCommunityWalk(d) {
      let w = d.get('walk', null);
      return w == null ? (d.topic != '산책' || !('walk' in d)) :
        d.topic == '산책' && w is map && w.keys().hasAll(['kind', 'steps', 'goal', 'date']) && w.keys().hasOnly(['kind', 'steps', 'goal', 'date'])
        && w.kind in ['today', 'total'] && w.steps is int && w.steps >= 0
        && (w.kind == 'today' ? w.steps <= 200000 : w.steps == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('steps', 0))
        && w.goal in [1000, 3000, 5000, 10000] && w.date is string && w.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /communityPosts/{postId} {
      function photoExists(id) { return getAfter(/databases/$(database)/documents/communityPosts/$(postId)/photos/$(id)).data.uid == request.auth.uid; }
      function validPhotos(d) {
        let ids = d.get('photos', []);
        return ids is list && ids.size() <= 3 && ids.toSet().size() == ids.size() && ids.hasOnly(['0', '1', '2']) && (d.topic != '자랑' || ids.size() == 0)
          && (ids.size() < 1 || photoExists(ids[0])) && (ids.size() < 2 || photoExists(ids[1])) && (ids.size() < 3 || photoExists(ids[2]));
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['uid', 'name', 'avatar', 'topic', 'title', 'body', 'character', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'topic', 'title', 'body', 'character', 'characters', 'photos', 'walk', 'questionTag', 'createdAt'])
        && isCommunityAuthor(request.resource.data) && request.resource.data.topic in ['자유', '자랑', '질문', '산책']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
        && validCommunityAnimals(request.resource.data) && validPhotos(request.resource.data) && validCommunityWalk(request.resource.data)
        && (!('questionTag' in request.resource.data) || (request.resource.data.topic == '질문' ? request.resource.data.questionTag in ['뽑기', '합성·진화', '걸음·지도', '계정·기타'] : request.resource.data.questionTag == null))
        && request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      match /photos/{photoId} {
        function parentAfter() { return getAfter(/databases/$(database)/documents/communityPosts/$(postId)).data; }
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/communityPosts/$(postId)) && photoId in get(/databases/$(database)/documents/communityPosts/$(postId)).data.get('photos', []);
        allow create: if isSignedIn() && parentAfter().uid == request.auth.uid && photoId in parentAfter().get('photos', [])
          && request.resource.data.keys().hasAll(['uid', 'data', 'width', 'height', 'createdAt']) && request.resource.data.keys().hasOnly(['uid', 'data', 'width', 'height', 'createdAt'])
          && request.resource.data.uid == request.auth.uid && request.resource.data.data is string && request.resource.data.data.size() <= 350000 && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.width is int && request.resource.data.width > 0 && request.resource.data.width <= 1200 && request.resource.data.height is int && request.resource.data.height > 0 && request.resource.data.height <= 1200
          && request.resource.data.createdAt == request.time;
      }
      match /comments/{commentId} {
        function parentExists() { return exists(/databases/$(database)/documents/communityPosts/$(postId)); }
        function validReply(d) {
          let parentId = d.get('parentId', null);
          return parentId == null ? d.get('replyTo', null) == null : parentId is string
            && exists(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(parentId))
            && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(parentId)).data.get('parentId', null) == null
            && !get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(parentId)).data.get('deleted', false)
            && d.replyTo is string && d.replyTo.size() > 0 && d.replyTo.size() <= 30;
        }
        allow read: if isSignedIn() && parentExists();
        allow create: if isSignedIn() && parentExists()
          && request.resource.data.keys().hasAll(['uid', 'name', 'avatar', 'body', 'createdAt']) && request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'body', 'parentId', 'replyTo', 'deleted', 'createdAt'])
          && isCommunityAuthor(request.resource.data) && validReply(request.resource.data) && request.resource.data.get('deleted', false) == false
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500 && request.resource.data.createdAt == request.time;
        allow update: if isSignedIn() && parentExists() && resource.data.uid == request.auth.uid && !resource.data.get('deleted', false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'deleted']) && request.resource.data.body == '' && request.resource.data.deleted == true;
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
        match /likes/{uid} {
          function commentVisible() { return exists(/databases/$(database)/documents/communityPosts/$(postId)) && exists(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)) && !get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)).data.get('deleted', false); }
          allow read: if isSignedIn() && commentVisible();
          allow create: if isOwner(uid) && commentVisible() && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
          allow delete: if isOwner(uid);
        }
      }
      match /likes/{uid} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/communityPosts/$(postId));
        allow create: if isOwner(uid) && exists(/databases/$(database)/documents/communityPosts/$(postId)) && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
      }
    }
    function isMedalCollection(id, chars) {
      return exists(/databases/$(database)/documents/gachaCollections/$(id))
        ? chars.keys().hasAll(get(/databases/$(database)/documents/gachaCollections/$(id)).data.characterIds) && !chars.values().hasAny([0])
        : (id == 'normal' ? (chars.get('mouse', 0) > 0 && chars.get('cow', 0) > 0 && chars.get('tiger', 0) > 0 && chars.get('rabbit', 0) > 0 && chars.get('dragon', 0) > 0 && chars.get('snake', 0) > 0 && chars.get('horse', 0) > 0 && chars.get('sheep', 0) > 0 && chars.get('monkey', 0) > 0 && chars.get('chicken', 0) > 0 && chars.get('dog', 0) > 0 && chars.get('pig', 0) > 0) : id == 'autumn' ? (chars.get('autumn_mouse', 0) > 0 && chars.get('autumn_cow', 0) > 0 && chars.get('autumn_tiger', 0) > 0 && chars.get('autumn_rabbit', 0) > 0 && chars.get('autumn_dragon', 0) > 0 && chars.get('autumn_snake', 0) > 0 && chars.get('autumn_horse', 0) > 0 && chars.get('autumn_sheep', 0) > 0 && chars.get('autumn_monkey', 0) > 0 && chars.get('autumn_chicken', 0) > 0 && chars.get('autumn_dog', 0) > 0 && chars.get('autumn_pig', 0) > 0) : id == 'sea' ? (chars.get('sea_mouse', 0) > 0 && chars.get('sea_cow', 0) > 0 && chars.get('sea_tiger', 0) > 0 && chars.get('sea_rabbit', 0) > 0 && chars.get('sea_dragon', 0) > 0 && chars.get('sea_snake', 0) > 0 && chars.get('sea_horse', 0) > 0 && chars.get('sea_sheep', 0) > 0 && chars.get('sea_monkey', 0) > 0 && chars.get('sea_chicken', 0) > 0 && chars.get('sea_dog', 0) > 0 && chars.get('sea_pig', 0) > 0) : id == 'cats' ? (chars.get('cats_abyssinian', 0) > 0 && chars.get('cats_american_shorthair', 0) > 0 && chars.get('cats_bengal', 0) > 0 && chars.get('cats_british_shorthair', 0) > 0 && chars.get('cats_maine_coon', 0) > 0 && chars.get('cats_persian', 0) > 0 && chars.get('cats_ragdoll', 0) > 0 && chars.get('cats_russian_blue', 0) > 0 && chars.get('cats_siamese', 0) > 0 && chars.get('cats_turkish_angora', 0) > 0) : id == 'cats_rare' ? (chars.get('cats_rare_abyssinian', 0) > 0 && chars.get('cats_rare_american_shorthair', 0) > 0 && chars.get('cats_rare_bengal', 0) > 0 && chars.get('cats_rare_british_shorthair', 0) > 0 && chars.get('cats_rare_maine_coon', 0) > 0 && chars.get('cats_rare_persian', 0) > 0 && chars.get('cats_rare_ragdoll', 0) > 0 && chars.get('cats_r